\usepackage[margin=1in]{% templatetag openbrace %}géométrie}

\nnnouvel environnement{% templatetag openbrace %}subproof}[1][\proofname]{% templatetag openbrace %}%
  \rrenouvellementcommande{% templatetag openbrace %}\qedsymbole}{% templatetag openbrace %}$\blacksquare$} %
    \début{% templatetag openbrace %}preuve}[#1]%
    }{% templatetag openbrace %}%
    \end{% templatetag openbrace %}preuve : %
}

% de packages AMS

