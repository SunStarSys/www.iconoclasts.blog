\section{Wärmekerne als Radon-Nikodym-Derivate von Weiner Measure}

\Abschnitt{Notation}

$M$ ist eine negativ gekrümmte $\dim=n$ geschlossene Riemannsche Mannigfaltigkeit mit Metrik $g$, Metrikverbindung $\nabla$ und (nonnegativem) Laplace-Beltrami-Operator $\Delta_M$.  Lassen Sie $k_{-t\Delta/2}(x,y)$ den Heat-Kernel auf $M$ darstellen.

Daher ist $k_{-t\Delta/2}(x,x) = dDM_*\mu/\sqrt{g}dx$ die Radon-Nicodym-Ableitung der n-dimensionalen Wiener Measure $\mu$, die auf das Pullback des kontinuierlichen Loop-Bereichs $\Omega_t(M)\vert_x$ über die Umkehrung der Weiner Measure-Erhaltungsentwicklungskarte $DM$ beschränkt ist. *Hinweis:* $DM^{-1}\Omega_t\vert_x$ ist kein Loop-Bereich.

$\Omega_t^0$ ist der Bereich von kontinuierlichen vertragbaren Schleifen auf $M$.

$\Omega_t[\gamma]$ ist der Speicherplatz von kontinuierlichen Schleifen auf $M$ homotopic zu der geschlossenen geodätischen $\gamma$. $\gamma_0$ soll die primitive Schleife sein.

$DM^{-1}\Omega_t^0[\gamma]$ ist das Vorbild kontinuierlicher vertragsmäßiger Schleifen bei $M$, die als Offsets homotopic zu $\gamma(s) = DM(\frac{s\ell(\gamma)}{t}\vec{e}^1), 0\leq s \leq t$ geschrieben werden. Denken Sie an Horocyclische Koordinaten - jede Faser als geometrische Grenze periodischer geodätischer Sphären $S_{\gamma_0(s)}^{n-1}(k\ell(\gamma_0)), 0\leq s \leq t, k\rightarrow\infty$, vektorisiert im Normal Bundle über $\gamma_0$. Unsere Krümmungsbeschränkungen bedeuten, dass Horocyclische Koordinaten für jedes $\gamma_0$ als glatte, $DM$-kompatible Koordinatenzuordnung für $\Omega_t^0[\gamma]$ vorhanden sind.

Jetzt ist $\vec{x}(\tau)+\ell(\gamma)\vec{e}^1$ der \textit{undeveloped} Endpunkt des Homotops "offset" \textit{kinked geodesic} zu $\gamma: DM(\vec{x}(\tau) + \frac{s\ell(\gamma)}{t}\vec{e}^1), 0\leq s \leq t$. Die Kurve ist periodisch mit dem Zeitraum $\ell(\gamma_0)$, und sie besucht den verknickten Startpunkt $DM(\vec{x}(\tau))$ zum Zeitpunkt $t$, wodurch die Berechnung des Vorwärtsderivats $J=\lim_{s\uparrow t}DM^\prime\vert_{DM(\vec{x}(\tau) + \frac{\ell(\gamma)s}{t}\vec{e}^1)}$ als linearer Automatorphismus von $T_{DM(\vec{x}(\tau))}M$ machbar wird. Wichtig ist, dass $J_{DM(\vec{x}(\tau)+\ell(\gamma)\vec{e}^1)}$ mit \textbf{Jacobi Fields} erstellt werden kann, da $DM$ \textbf{is} die (iterierte) exponentielle Zuordnung entlang einer Reihe verbundener gerader Linien in $\mathbb{R}^n$ ist. Wir untersuchen $ 1/2 \int_0^t \bra{dX}\ket{dX}_s$ mit der Lösung

\begin{equation}
\begin{aligned}
X_t &amp;= X_0 + \int_0^t \sqrt{J}_{X_t} dB_t  \\
\end{ausgerichtet}
\end{equation}

$Z_{-\Delta/2}(t) := \int_M k_{-t\Delta/2}(x,x) \sqrt{g}dx = \sum_{j=0}^\infty e^{-\lambda_i t/2}$ ist das Trace des Heat-Kernels.

Lasst uns schließlich folgendes aus ihren Radon-Nicodym-Derivaten definieren:

\begin{equation}
\begin{aligned}
DM_*\mu(\Omega_t) &amp;:= \int_M DM_*\mu(\Omega_t\vert_x \sqrt{g}dx)\\
DM_*\mu(\Omega^0_t) &amp;:= \int_M DM_*\mu(\Omega^0_t\vert_x \sqrt{g}dx)\\
DM_*\mu(\Omega_t[\gamma]) &amp;:= \int_M DM_*\mu(\Omega_t[\gamma]\vert_x \sqrt{g}dx) \\
\end{ausgerichtet}
\end{equation}

\section{Stochastische Trace-Formel}

\begin{equation}
\begin{aligned}
Z_{-\Delta/2}(t) = DM_*\mu(\Omega_t) &amp;= DM_*\mu(\Omega^0_t) + \sum_{\set{\gamma}} DM_*\mu(\Omega_t[\gamma]) \\
DM_*\mu(\Omega_t^0) &amp;\approx_{t\rightarrow 0} (2\pi t)^{-n/2}(vol(M) + t/6\int_M K(x)\sqrt{g} dx + O(t^2))\space \small\text{by McKean-Singer}\\\
DM_*\mu(\Omega_t[\gamma]) &amp;= e^{-\ell(\gamma)^2/2t}\int_M DM_*\mu(e^{\bra{J_BB_t}\ket{B_t}} _t \Omega_t^0[\gamma]\vert_x\sqrt{g}dx)\space\small \text{ von Cameron-Martin}\\
&amp;= e^{-\ell(\gamma)^2/2t}\int_{T_{\gamma_0}M} E(e^{J_B}_{t} | \Omega_t^0[\gamma]\vert_{x(\tau)})dx^1(\tau)\dots dx^n(\tau) d\tau\\\\\\
\frac{dDM_*\mu(e^{-\ell(\gamma)x^1(t)}\Omega^0_t[\gamma])}{dx^1(\tau)\dots dx^n(\tau)d\tau}\vert_{\vec{y(\tau)}}&amp;\approx_{t\rightarrow 0} \frac{e^{-\bra{|I-J_{DM(\vec{x}(\tau),\vec{y}(\tau))}\vec{x}(\tau)}\ket{\vec{x}(\tau)}/2t}}{(2 \pi t)^{(n+1)/2}}(1+O(t^2))\small \text{ halbklassischer Grenzwert}\\
\text{Horocyclische Koordinaten}: z(\tau) - x(\tau) &amp;= x + \ell(\gamma)\vec{e}^1\implies\\
\int_{M/S^1\oplus S^1}k_t(x,z) dx &amp;=\lim_{j\rightarrow\infty}\frac{e^{-\ell(\gamma)^2/2t}}{\sqrt{2\pi t}}E(e^{\bra{J_{X^j_t}\vec{x}}\ket{\vec{x}}})\\\
&amp;=\lim_{j\rightarrow\infty}\frac{e^{-\ell(\gamma)^2/2t}}{\sqrt{2\pi t}}\int_{M^j/S^1\oplus S^1}\frac{1}{\sqrt{2\pi t}^{jn}\det|I-J_{X^j}|}e^{-\ell(X^j)^2/2t}X^{j}\\\
\end{ausgerichtet}
\end{equation}

\section{Approximation und Selberg Trace Formula}

In der $\dim = 2$ konstanten Krümmung $-\kappa^2$ Oberflächengehäuse,

\begin{equation}
\begin{aligned}
\sqrt{J_{\vec{x}, \vec{y}}}dRB&amp;=
\begin{pmatrix}
e^{\kappa d(\vec{x},\vec{y})/2} &amp;&amp; 0\\
0 &amp;&amp; e^{-\kappa d(\vec{x},\vec{y})/2}\\
\end{pmatrix}
\implikationen&amp;\\
\bra{\sqrt{J}dRB}\ket{\sqrt{J}dRB} &amp;= e^{\kappa \ell(B)}dRB_1^2 - e^{-\kappa \ell(B)}dRB_2^2\\
\int_0^t \bra{\sqrt{ J}dB}\ket{\sqrt{ J}dB} &amp;= e^{\kappa\ell(\gamma)} - e^{-\kappa\ell(\gamma)}\\
\det I-J_{\gamma} &amp;= (e^{\kappa\ell(\gamma)/2}- e^{-\kappa\ell(\gamma)/2})^2
\end{ausgerichtet}
\end{equation}

die über $(\vec{x},\tau)$ konstant ist, sodass die Näherungslinie $\approx_{t\rightarrow 0}$ in Gleichung (2) zu \textit{exact} wird:

\begin{equation}
\begin{aligned}
DM_*\mu(\Omega_t[\gamma]) &amp;= \frac{e^{-\ell(\gamma)^2/2t}\ell(\gamma_0)}{\sqrt{2 \pi t}(e^{\kappa\ell(\gamma)/2} -e^{-\kappa\ell(\gamma)/2})}\\
\gamma(t) = \gamma_0(kt)\implies \\
&amp;=\frac{e^{-k^2\ell(\gamma_0)^2/2t}\ell(\gamma_0)}{2\sqrt{2\pi t}\sinh k\kappa\ell(\gamma_0)/2}\\
\end{ausgerichtet}
\end{equation}

Im hyperbolischen Verteiler von $\dim=3$ verwenden wir komplexe Koordinaten $(z,\bar{z})$ für das normale Bundle zum Schreiben

\begin{equation}
\begin{aligned}
J_{DM(\vec{x}+(\tau+\ell(\gamma))\vec{e}^1)} &amp;=
\begin{pmatrix}
e^{\kappa\ell(\gamma)} &amp;&amp; 0 &amp;&amp; 0\\
0 &amp;&amp; e^{-\kappa\ell(\gamma)+i\theta(\gamma)} &amp;&amp; 0 \\
0 &amp;&amp; 0 &amp;&amp; e^{-\kappa\ell(\gamma)-i\theta(\gamma)} \\
\end{pmatrix}\\
\implikationen&amp; \\
\det I-{\perp_{\gamma_0}}^k &amp;= |1-e^{-k(\kappa\ell(\gamma_0)-i\theta(\gamma_0))}|^2
\end{ausgerichtet}
\end{equation}
und da $z=x^2+ix^3 \implies d\bar{z}\wedge dz= (dx^2-idx^3)\wedge(dx^2+idx^3) = 2idx^2\wedge dx^3$ ist, wird die Näherung in Gleichung (2) wieder exakt:

\begin{equation}
\begin{aligned}
\kappa &amp;= 1 \implies \\
DM_*\mu(\Omega_t[\gamma])
&amp;=\frac{e^{-k^2\ell(\gamma_0)^2/2t}\ell(\gamma_0)}{2\sqrt{2\pi t (1-e^{-k\ell(\gamma_0)})}|e^{k\ell(\gamma_0)/2}-e^{-k(\ell(\gamma_0)/2-i\theta(\gamma_0))}|}\\\\
\end{ausgerichtet}
\end{equation}

