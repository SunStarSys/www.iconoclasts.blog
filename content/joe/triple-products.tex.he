\התחל{document}

מקטיט

\התחל{abstract}
באמצעות טכניקות יסודיות מניתוח גיאומטרי, משוואות דיפרנציאליות חלקיות, ו- $C^*$ Algebras Abelian, אנו חושפים רומן, אך מוכר, משתנה גיאומטרי גלובלי - כלומר קבוצה ממופתחת של אינטגראלים של מוצרים משולשים של פונקציות הילידים של מפעיל Laplace-Beltrami, כדי לאפיין במדויק איזה סעפת רימאנית סגורה isospectral הם איזומטריים.

\noindent\textbf{Keywords:} ספקטרום, פורייה, הרמונית, מוצרים משולשים, Laplacian, פונקציות עצמיות, פונקציונלי, בעיה הפוכה, תורת הייצוג
\end{abstract}

\tableofcontents

\חלק{מבוא}
\label{sec:intro}

עבור סעפת רימאנית סגורה $(M,g)$, המאפיינת את המעמד שלה לא איזומטרי, סעפת isospectral הוא סוג של בעיה הפוכה \cite{DH11} בגיאומטריה ספקטרלית. אפשר לשער שהשיעור הזה תמיד יהיה ריק. עם זאת, הספרות האקדמית עשירה עם מבנים בני עשרות שנים של זיווגים ספציפיים של דוגמאות נגדיות: החל משנת 1964 עם זוג 16-ממדי של ג'ון מילנור של לא איזומטרי, isospectral שטוח tori \cite{JM64}, והמשך \cite{CS92} לקראת אפיון ממדי כללי של טורי שטוח בתזה הדוקטורט של אלכסנדר שימן משנת 1993 \cite{AS94} -- שלם עם חיפוש בעזרת מחשב עבור מקרה $\dim קריטי = 3$.  סקר מודרני של ההיסטוריה המלאה של טורי שטוח מופיע ב- \cite{NRR22}.

לאורך הדרך היו מגפיים תובנות לתוך חללי כיסוי סימטריים מתוחכמים יותר, לא אוקלידיים; בניית "דוכני" איזוספקטרליים, לא איזומטריים כאלה מעורבים טנזור עקמומיות לא טריוויאלי (והמאפיינים שלהם אוילר קבוע הספקטרום בממד 2 \cite{MS67}.) דוגמה עיקרית למאמץ זה הייתה המצאתו של טושיקאזו סונאדה מ-1985 \cite{TS85} של מסגרת חלל המכסה למטרה כללית, אותה הוא פרס באותה עבודה לבניית דואטים היפרבוליים בממדים 2 ו-3.

עבור מדדים רימאניים לא הומוגניים, קרולין גורדון גילתה דואטים שאינם אפילו איזומטריים מקומיים \cite{CG93}.

העבודה נמשכת בתחומים רבים הקשורים \cite{DH11}, כגון קביעת מאפיינים טופולוגיים של המעמד של סעפות איזוספטראליות, לא איזומטריות באופן כללי (ריק \cite{ST80}, סופי \cite{AS94}, נוקשה \cite{GK80}, קומפקטי \cite{GZ97}) כתת-קבוצה של מרחבי מודולי שונים של מדדים רימאניים.

מה שאנו מציעים במאמר זה הוא פרספקטיבה חדשה על כלי מוכר: מקדמי פורייה ממופתחים של מוצרים זוגיים של eigenfunctions כמו "משתנה אלגברי/טופולוגי" דיסקרטי כדי להשלים את הקיים, "משתנה אנליטית" בדיד - הספקטרום הלא שלילי של אופרטור Laplace-Beltrami (להלן: "לא שלילי") \textit{Laplacian}) על $\mathscr H = L^2(M,g)$.  בשילוב, אנו רואים את הזוג מספק "ייצוג גיאומטרי גלובלי נפרד" של המעמדות האיזומטריים של סעפות רימאניות סגורות.

\תת-חלק{תוצאות}
\label{subsec:res}

\begin{theorem}
\label{thm}

בהינתן (לא יורד על ערכי הילידים) בסיס אורתונורמלי של פונקציות הילידים $\set{e^i}_{i=0}^{\infty}$ עבור (לא שלילי) Laplacian $\Delta_M$ על $L^2(M,g)$ המשויך סעפת רימאנית סגורה $(M,g)$, להגדיר

\begin{equation}
M^{i,j,k} := \int_M e^i e^j \bar{e^k} \sqrt{g} dx = \bra{e^i e^j}\ket{e^k}
\end{equation}

כדי להיות איזומטרי ל $(M,g)$, זה תנאי הכרחי ומספיק עבור סעפת רימאנית סגורה isospectral אחר יש בסיס אורתונורמלי של פונקציות עצמיות (עבור Laplacian שלה) כי שניהם שומרים את הערכים העצמיים הקשורים ויש להם משתנה $\set{M^{i,j,k}}$ תחת כל בסיס.
\סוף{theorem}

\textit{Symmetry} ממלא תפקיד חשוב במקרים הניתנים לחישוב \cite{TF17} \cite{LS18} \cite{PS94}, שמודגם בצורה נכונה בטורי השטוח שלנו לדוגמה~\ref{sec:ex} להלן. עם זאת, כוחו של הגישה שלנו הוא אולי הכי בולט במקרה של סעפות עם המספר הקטן ביותר של סימטריות רימאניות, וזה המקרה הגנרי לעתים קרובות עולה בקנה אחד עם הערכים העצמיים להיות ייחודי (כלומר, ללא ריבוי לא טריוויאלי). במקרה זה, אנו מציעים את הדברים הבאים:

\begin{conjecture}
\label{conj}
אם לכל ערך עצמי יש כפל $1$, בהתחשב בזוג של בסיסים אורתורמליים שומרי ערך עצמי כמתואר בהשערה של המשפט, סעפות הן איזומטריות אם ורק אם $\set{M^{i,j,k}}$ עבור בסיס אחד מסכים, עד ערך מוחלט במונחים בודדים, עם הבסיס השני.
\end{conjecture}

המוטיבציה למחקר של $\set{M^{i,j,k}}$ נגזרת באופן רופף מהמחקר של התפקיד של אופרטור הכפל הבילינארי $Y:V\otimes V\rightarrow V(z))$ בהגדרה של אלגברת אופרטור Vertex \cite{FBZ04} המשויכת לתורת שדה קונפורמי כיראלי. כאן $V$ הוא המרחב הווקטורי של מדינות ו $V(z))$ הוא המרחב של סדרת לורן רשמית ב $z$ עם מקדמים ב $V$. מאז $V$ לעתים קרובות מגיע מצויד כחלל הילברט עם בסיס אורתונורמלי סדרת פורייה המסורתית, מפתוח $Y$ באמצעות אלמנטים בסיס פורייה של $V$ הוא רק קצת יותר מעורב מאשר המקרה $M^{i,j,k}$ למד כאן, אבל די דומה ברוח. עם זאת, השוואה מפורטת אינה בטווח למאמר זה.

אם ניקח בחשבון את המפה
\begin{equation}
(M, g, \set{e^i}) \mapsto \set{\lambda_i, M^{i,j,k}}\ ,
\end{equation}

מאמר זה קובע את הזריקות של מפה זו עבור סעפת רימאנית סגורה (עד איזומטריה רימאנית בתחום שלה). תוצאות נוספות שמחילות טכניקות אלה כדי לתאר את התמונה שלה (והיפוך), בתוך מרחבי מדדים מודולי נבחרים, רק מתחילות \cite{AA25}.  שם, Anshul Adve מתמודד בקפדנות עם מרחבים מוחשיים של 2-orbifolds קומפקטיים, היפרבוליים, תוך שימוש באותם \textit{structure constants} מתיאוריית שדה קונפורמית.

תוצאות אלה הודגמו לראשונה במהלך שיחה בשם דומה על ידי המחבר ב \textbf{MSRI} בשנת 1997, אבל הם מופיעים כאן בצורה שפורסמה בפעם הראשונה.

\חלק{מועדפים}
\label{sec:pre}

עכשיו עם $M,g,e^i,M^{i,j,k}$ כמו בהשערות של המשפט~\ref{thm}, עבור $f \in C^\infty(M)$ ו- $i \geq 0$ שים לב שה-\textit{Fourier coefficients}

\begin{equation}
\label{eqn:Fourier}
\התחל{aligned}
\hat{f}(i) &amp;:= \int_M f(x)\bar{e^i}(x)\sqrt{g(x)}dx \\
\פשוטים \\
f(x)        &amp;= \sum_{i=0}^{\infty}\hat{f}(i)e^i(x)\,,
\end{aligned}
\end{equation}

מכיוון ש-$f$ ניתן לייצוג ייחודי כ-\textit{Fourier Series} המתכנס במהירות ($\Delta_M$-specific Sobolev Embeddings \cite{MT13} \cite{RS75}, יחד עם החוק האסימפטוטי של וייל \cite{HW11}, מעיד על התנאים בסכום הם $o(i^{-n})$ באופן אחיד ב-$x$ \cite{LH68}, $\forall n\in\mathbb{N}$.) לאחר מכן אנו רואים כי עבור $f_1, f_2 \in C^\infty(M)$, מקדמי פורייה של מוצר נקודה $f_1 f_2 \in C^\infty(M)$ הם

\begin{equation}
\התחל{aligned}
\widehat{f_1 f_2}(k) &amp;= \sum_{i,j}^\infty\hat{f_1}(i)\hat{f_2}(j)M^{i,j,k} \\
\פשוטים \\
f_1f_2(x) &amp;= \sum_{i,j,k}\hat{f_1}(i)\hat{f_2}(j)M^{i,j,k}e^k(x) \\
f_1 &amp;= f^p_2,\, p > 2 \implies \\
\sum_{k}\hat{f_1}(k)e^k(x) &amp;= \sum_{i_1,i_2,\ldots,i_{2p-1}}\hat{f_2}(i_1)\hat{f_2}(i_2)\hat{f_2}(i_4)\hat {f_2}(i_6)\ldots\hat{f_2}(i_{2p-2})M^{i_1,i_2,i_3}M^{i_3,i_4,i_5}\ldots M^{i_{2p-3},i_{4}
\end{aligned}
\end{equation}

וכך, באופן ביקורתי, כל פולינום רב-משתני $\wp \in \mathbb{C}[z_1,\ldots,z_l]$ (על פונקציות חלקות) מגיע עם כל מפת בסיס אורתונורמלית $\Delta$-eigenfunction $\vec{F}$ ששומרת על $\set{M^{i,j,k}}$:

\begin{equation}
\label{fig}
\begin{tikzcd}
  C^\infty(M,\space\mathbb{C}^l)\arrow[swap]{d}{\underbrace{\vec{F}\oplus\dots\oplus \vec{F}}_{l\,\text{times}} \arrow{r}{\wp} &amp; C^\infty(M) \arrow{d}{\vec{F}}\\%
  C^\infty(N,\space\mathbb{C}^l) \arrow{r}{\wp} &amp; C^\infty(N)
\end{tikzcd}
\end{equation}

יתר על כן, אם $A\subset M$ ניתן למדידת Borel, אזי התוצאות לעיל מעוכבות בכיוון נקודה עבור הפונקציה האופיינית של $A$ בכל מקום מלבד לאורך הגבול של $A$: אם $f = f^2$ ו-$A:=\set{x\in M|f(x)=1}$,

\begin{equation}
\sum_{i}\hat{f}(i)e^i(x) = \sum_{i,j,k}\hat{f}(i)\hat{f}(j)M^{i,j,k}e^k(x) = \begin{cases}
1 ו-x \in \mathring{A} \\
0 ו-x \in \mathring{A^\complement}\end{cases}\,,
\end{equation}

ובייחוד יש לנו את הזהות הבאה

\begin{equation}
\התחל{aligned}
\hat{f}(k) &amp;= \sum_{i,j}\hat{f}(i)\hat{f}(j)M^{i,j,k}\,,\, \forall k\geq 0 \\
\iff f&amp;=f^2 \, a.e.
\end{aligned}
\end{equation}

משמעות הדבר היא כי כל מפת בסיס כמו לעיל נושאת פונקציות אופייניות (כאיברים של $L^2(M,g)\subset L^1(M,g)$) לפונקציות אופייניות באופן שימור מדד.

הנקודה של חישובים אלה היא להדגיש את העובדה כי $\set{M^{i,j,k}}$ מאפיינת את הניתוח ההרמוני של אופרטור הכפל Pointwise על $C^\infty(M)$, שהיא תת-אלגברה צפופה של האלגברה $C^*$ Abelian $C(M)$, על ידי משפט Stone-Weierstrass.

עבור ההתכנסות המהירה של אלה לעיל סכומים מעורבים $M^{i,j,k}$, שים לב כי מוצרים של פונקציות הילידים הם חלק, כך מקדמי פורייה אלה דועכים כמו לעיל (בכל אינדקס). לקבלת פרטים נוספים, עיין בעבודתו של אמט ויימן בשנת 2022 עם מקדמים אלה בכל הקשור לאי-שוויון המשולש בערכי הילידים \cite{EW22}.

הערה: אנו עשויים תמיד להניח

\begin{equation}
\התחל{aligned}
e^0 &amp;= M^{0,0,0} = 1/\sqrt{vol(M)} \\
\פשוטים \\
M^{0,j,k} &amp;= M^{j,0,k} = \delta_{j-k}\space/\sqrt{vol(M)}\,,
\end{aligned}
\end{equation}

כאשר $\delta_i$ הוא דלתא של קרונקר. מכיוון ש-$vol(M)$ הוא משתנה ספקטרלי \cite{HW11}, מידע זה כבר זמין משיקולי isospectrality.

\סעיף{הוכחת המשפט~\ref{thm}}
\label{sec:proof}

\התחל{proof}
לצורך הצורך, תן ל-$F:(N,h)\rightarrow (M,g)$ להיות איזומטריה בין סעפות רימאניות סגורות, ותן לבסיס האורתונורמלי של פונקציות עצמיות על $L^2(N,h)$ להיות המשיכה חזרה באמצעות $F$ של הבסיס האורתונורמלי $\set{e^i}$ על $(M,g)$ לעיל. מאז

\begin{equation}
\התחל{aligned}
M^{i,j,k} &amp;= \int_M e^i e^j \bar{e^k}\sqrt{g}dy \\
          &amp;= \int_N e^i(F(x)) e^j(F(x))\bar{e^k}(F(x))\sqrt{h}dx\,,
\end{aligned}
\end{equation}

סיימנו עם ארגומנט הצורך כי $\Delta_N(f\circ F) = (\Delta_M f) \circ F,\ \ \forall f\in C^\infty(M)$.

לצורך יעילות, אנו רואים כעת את מפת הבסיס ליניארית, בי-סובייקטיבית אורתונורמלית $\vec{F}$ מ-$C^\infty(M)$ ל-$C^\infty(N)$ ושים לב כי מהחישובים בסעיף~\ref{sec:pre} לעיל, $\vec{F}$ שומר על מוצרים עם כיוון נקודה עבור פונקציות חלקות (ומשמר פונקציות אופייניות כאשר הוארך ל-$L^2(M,g)$) על ידי ההנחה ש-$\set{M^{i,j,k}}$ אינו משתנה תחת מפה זו.

\begin{lemma}
\label{lma}
$\vec{F}: C^\infty(M)\rightarrow C^\infty(N)$ שומר על הנורמה האחידה.
\end{lemma}

\begin{subproof}[הוכחת Lemma~\ref{lma}]
תן ל-$\set{a_i}$ להיות מחיצה חלקה של אחדות ב-$M$.

\begin{equation}
\התחל{aligned}
1 &amp;= \sum_i a_i(x) \\
       &amp;= \sum_{i,j} \hat{a_i}(j)e^j(x) \\
	   &amp;= \sum_j e^j(x)\sum_i \hat{a_i}(j)
\end{aligned}
\end{equation}

לכן $\sum_i\hat{a_i}(j) = \delta_j\sqrt{vol(M)}$ (דלתת קרונקר).

על ידי משפט ההתכנסות הנשלט,
\begin{equation}
\lim_{p\rightarrow\infty}
\sum_j\hat{a^p_j}(k) = \int_{\dot{\bigcup}_j\set{a_j=1}}\bar{e^k}(x)\sqrt{g}dx\,,
\end{equation}

שהיא פונקציה אופיינית של מידה חיובית על כל תת-קבוצה של $\set{x\in M | a_j(x) = 1}$. פירוש הדבר הוא שהלמה מוכחת עבור כל $a_j$, מאחר שפונקציית המאפיין המגביל של קבוצה בעלת מדד חיובי נשמרת, ולכן יש לה נורמה אחידה 1, כמו גם כל $a_j^p,\, \vec{F}(a_j^p)=\vec{F}(a_j)^p,\, p\in\mathbb{N}$, לפי דיאגרמה~\ref{fig}.

ללא אובדן הכלליות, אנו עשויים להחיל את תוצאת המקרה המיוחדת המוצגת עבור המחיצה החלקה של אחדות $\lbrace|f|/\lVert f \rVert_\infty, 1 - |f|/\lVert f\rVert_\infty\rbrace$, כאשר $ \set{x\in M|\space|f(x)| = \lVert f \rVert_\infty}$ הוא בעל מדד חיובי, והלמה מוכחת במלואה.

\end{subproof}

מכיוון ש-$\set {\bar e^i}$ הוא גם בסיס פורייה עבור $L^2(M,g)$, ברור מהמשוואה~\ref{eqn:Fourier} ש-$\vec F(\bar f) = \bar{\vec F}(f)$. משמעות הדבר היא כי על קבוצה צפופה של $C(M)$ (ו-$C(N)$), הקמנו $\vec{F}$ כאיזומורפיזם של אלגבריות $C^*$ אבליות, ולכן ניתן להרחיב אותו לאיזומורפיזם של $C(M)$ ו-$C(N)$ באותה קטגוריה.

כעת אנו מיישמים את משפט הייצוג של גלפנד-ניימארק (בצורת פונקטור מנוגד) עבור אלגברות $C^*$ אלגבריות \cite{JC19} כדי לייצג את האיזומורפיזם $\vec{F}$ על ידי הומומורפיזם $F$ בין $N$ ו-$M$. מכיוון ש-$\vec{F}$ הוא נושאיות בפונקציות חלקות, גם $F$ חייב להיות חלק.

כמו זה עכשיו biffeomorphism שומר eigenvalues ו eigenfunctions (על ידי ההשערה על $\vec{F}(f) = f \circ F$), זה חייב לשמור על Laplacian על פונקציות חלקות. לכן $F$ גם חייב לשמור על הסמלים העיקריים של אותם אופרטורים אליפטיים \cite{MT13}. הסמלים העיקריים של Laplacian הם פשוט אמצעי נוסף לבטא את המדד רימאני על סעפת המדובר.

זה משלים את ההוכחה של המשפט.

\סוף{proof}

\subsection{Discussion of Conjecture~\ref{conj}}
\label{subsec:conj}

עם $\set{M_0^{i,j,k}}$ ו-$\set{M_1^{i,j,k}}$ מייצג את שתי קבוצות המוצרים המשולשים לבסיסים $\set{e_0^i}$ ו-$\set{e_1^i}$, תן ל-$z_i \in \set{-1,1}$ להיות הפעולה $\mathbb{Z}_2^\infty$ על בסיס אורתונורמלי כזה $\mathbb{R}$-ערך $\set{e_1^i}$. לכן, עלינו לבחור ב-$z_i$ כדי ש-$\set{z_ie_1^i}$ יניב $\set{M_1^{i,j,k}} = \set{z_i z_j z_kM_0^{i,j,k}}$.

למה זה המצב? באופן כללי, קבוצת הסימטריה הפועלת על המרחב של בסיסים אורתונורמליים אפשריים של פונקציות עצמיות היא המרחב של מפעילים אוניטריים $U: \mathscr H\rightarrow\mathscr H$ שמתחילים עם תחזיות $P_{\mathcal V_\lambda}$ על השמיניות הסופיות-מממדיות $\mathcal V_{\lambda}$ המשויכות לכל ערך עצמי $\lambda$ של Laplacian. לכן

\begin{equation}
\התחל{aligned}
P_{\mathcal V_{\lambda}}U(e^i) = UP_{\mathcal V_{\lambda}}(e^i),\ \therefore U(e^i) &amp;= \sum_{\lambda_i = \lambda_j}u_{ij}e^j \implies \\
M_U^{i,j,k} := \int_M U(e^i)U(e^j)\bar U(\bar e^k)\sqrt g dx &amp;= \sum_{\lambda_r = \lambda_i,\lambda_s=\lambda_j,\lambda_t=\lambda_k} u_{ir}u_{js}\bar u_{tk} M^{r,s,t}
\end{aligned}
\end{equation}

היא התמונה של $M^{i,j,k}$ תחת פעולת הבסיס של $U$ $e^i \mapsto U(e^i)$.

עכשיו תחת תנאי ההשערה, כל אחד מ-$\mathcal V_\lambda$ הם מרחבים וקטוריים ממדיים אחד מעל $\mathbb{C}$, אבל זה גם אומר שהם מרחבים וקטוריים ממדיים אחד מעל $\mathbb{R}$, ולכן קבוצת הסימטריה הכפולת המלאה היא $O(1,\mathbb{R})^\infty=\mathbb{Z}_2^\infty$.

ללא אילוץ הריבוי, הדרישה המקדימה המשויכת של ההשערה "הסכם רישום בערכים מוחלטים" תהפוך ל"שמירה על קבוצה מסודרת של ערכים יחידים של $\set{M^{i,j,k}}$, שנספרה עם כפל, כאשר היא מוצגת כאוסף של מפות מ-$\mathcal V_{\lambda_i} \rightarrow Hom(\mathcal V_{\lambda_j}, \mathcal V_{\lambda_k}^*)$". מסתבר שמדובר במערכת חזקה למדי של בלתי-משתנים. אנחנו הרבה פחות בטוחים כי ההשערה הכללית הזו נכונה, שכן ייתכן שניתן להפיק דוגמה נגדית באמצעות בנייה מפורשת של סאנדה.

בחזרה להשערה המקורית, אנו מבחינים כי ההוכחה כרוכה בהקמת משמעות זו:

\begin{equation}
\label{fml}
z_k = M_0^{i,i,k} / M_1^{i,i,k} \,\, \forall i,k\in\mathbb{N},\,  ⁇  M_0^{i,i,k} \ne 0 \, \implies
\קיימת r,s,t \in \mathbb{N}\  ⁇ \ \frac{M_0^{i,j,k}}{M_1^{i,j,k}} = \frac{M_0^{r,r,i}M_0^{s,s,j}M_0^{t,t,k}}{M_1^{r,r,i}M_1^{s,s,j}M_1^{t,t,k}}\,.
\end{equation}

אנו עשויים לקוות כי עבור כל נתון $k$, $M_0^{i,i,k}$ לא יכול להיות זהה $0$ עבור כל $i$. בסומק הראשון, זה לא נראה בלתי אפשרי אם ל-$M$ יש קבוצת סימטריה "אפילו/קודד", ו-$e^k$ הוא מוזר, אבל התקווה נכונה במקרה השטוח-טורי למטה (אשר אינו מקיים את ריבוי הערכים העצמיים האחידים = 1 תנאי). יתר על כן, הנוסחה~\ref{fml} עבור $z_k$ דורשת גם $i$-עצמאות וגם יעילות, כדי לקבוע את מפת הבסיס $e_0^i \mapsto z_i e_1^i$ שומר על $\set{M_0^{i,j,k}}$. כל אלה עדיין לא ידועים.

עם זאת, הבה נחשוב כמה זהויות רלוונטיות כדי שחוקר עתידי נבוך יוכל לחפור בהשערה זו:

\begin{equation}
\התחל{aligned}
\Delta fg &amp;= f\Delta g + g\Delta f - 2 df \cdot dg \implies \\
M^{i,j,k} &amp;= 2 \frac{\bra{de^i\cdot de^j}\ket{e^k}}{\lambda_i +\lambda_j -\lambda_k}\\
\טקסט{עכשיו על ידי קיטוב}\\
M^{i,j,k} &amp;= \frac{\bra{(e^i+e^j)^2 - (e^i - e^j)^2}\ket{e^k}}{4} = \frac{M^{i,i,k} + M^{j,j,k} - \bra{(e^i-e^j)^2}\ket{e^k}}{2},\\\
\טקסט {וכך הצורה הריבועית} \\
Q_k(f,g) :&amp;= \bra{df\cdot dg}\ket{e^k} = \sum_{i,j}\hat{f}(i)\hat{g}(j)\bra{de^i\cdot de^j}\ket{e^k} \\
&amp;= \frac{1}{2}\sum_{i,j}\hat{f}(i)\hat{g}(j)(\lambda_i + \lambda_j - \lambda_k)M^{i,j,k}.\\
\text{Now with}\, J\, \text{real-analytic}\\
Q^J_k(f,g) :&amp;= -\frac{1}{2}\bra{(J(\sqrt{\Delta})fg - fJ(\sqrt{\Delta})g - gJ(\sqrt{\Delta})f}\ket{e^k} \\
&amp;= -\frac{1}{2}(\bra{fg}\ket{J(\sqrt{\Delta}) e^k} - \bra{fJ(\sqrt{\Delta})g + gJ(\sqrt{\Delta})f}\ket{e^k})\\\
&amp;= \frac{1}{2}\sum_{i,j}\hat{f}(i)\hat{g}(j)(J(\sqrt{\lambda_i}) + J(\sqrt{\lambda_j}) - J(\sqrt{\lambda_k})M^{i,j,k}\\
\טילדה{Q}_k(f,g) :&amp;= -\frac{1}{2}\bra{\sqrt{\Delta} fg - f\sqrt{\Delta}g -g\sqrt{\Delta}f}\ket{e^k} \\
&amp;= \frac{1}{2}\sum_{i,j} \hat{f}(i)\hat{g}(j)(\sqrt{\lambda_i} + \sqrt{\lambda_j} - \sqrt{\lambda_k})M^{i,j,k}\\
df \cdot dg &amp;= \sum_k Q_k(f,g)e^k = -\frac{\Delta fg - f\Delta g - g\Delta f}{2}\\
Q_0(f,f) &amp;= \frac{1}{\sqrt{vol(M)}}\sum_i \hat{f}(i)^2 \lambda_i\\
df\cdot df = \sum_kQ_k(f,f)e^k &amp;= \frac{1}{2}\sum_{i,j,k}\hat{f}(i)\hat{f}(j)(\lambda_i + \lambda_j -\lambda_k)M^{i,j,k}e^k\\\
&amp;= \frac{1}{4}\sum_{i,j,k}\hat{f}(i)\hat{f}(j)(\lambda_i + \lambda_j -\lambda_k)(M^{i,i,k} + M^{j,j,k} - \bra{(e^i-e^j)^2}\ket{e^k})e^k\\\
 = g^2 &amp;= \sum_{i,j,k}\hat{g}(i)\hat{g}(j)M^{i,j,k}e^k \implies\\\
 \frac{1}{2}\sum_{i,j}\hat{f}(i)\hat{f}(j)(\lambda_i + \lambda_j - \lambda_k)M^{i,j,k} &amp;= \sum_{i,j}\hat{g}(i)\hat{g}(j)M^{i,j,k} \\
&amp;= \widehat{g^2}(k). \\
\end{aligned}
\end{equation}

הערה: במקרה החד-ממדי של טורי אחיד להלן, $\tilde{Q}_k(e^i,e^j) = 0$ כיוון ש-$\sqrt{\Delta} = \sqrt{-1}\frac{d}{dx}$ הוא גזירה אמיתית.

\חלק{דוגמה}
\label{sec:ex}

תן ל-$\set{\lambda_i} \subset \mathbb{R}^n$ להיות ממופתח, דרג $n$ סריג של משקלי Lie Algebra לייצוג שטח המנה של $\mathfrak{g}=\mathbb{R}^n$ כשדות וקטוריים של תרגום (כלומר, קבוע) בפני עצמו, כאשר $\mathbb{R}^n$ מוצג גם כ-$\mathfrak{g}$'s Associated Lie Group על טורוס שהוגדר על ידי $\mathbb{R}^n/A\mathbb{Z}^n, A \in GL(n,\mathbb{R})$. משקולות אלה מגדירים מעליות אינטגראליות של 1 צורות מעל הטורוס שמשתלבות לפונקציות לינאריות $\bra{x} \lambda_i\rangle,\, x\in\mathbb{R}^n$ כקבוצת השקר שלה (מכסה את הטורוס). לאחר מכן ניתן להציל פונקציות לינאריות אלה באופן אחיד (על ידי $2\pi \sqrt{-1}$) ולהרכיב אותן כדי ליצור תווים מכפילים שיורדים ליצירת בסיס אורתונורמלי של $L^2(\mathbb{R}^n/A\mathbb{Z}^n,dx)$, כאשר Lebesgue (Haar) מודדת $dx$.

יתר על כן, בסיס זה במקביל לאלכסון לפלאציאן של הטורוס השטוח, משום שהלפלציאן הוא דמות של אלמנט קזימיר ריבועי סימטרי, שלילי-מוגדר תחת זה (אופרטור דיפרנציאלי ליניארי מקדם קבוע) ייצוג מרחב של אלגברת המעטפות האוניברסלית. מכאן, שערכיו העצמיים נמצאים בפרופורציה קבועה (מתוך $4\pi^2$) ל-Casimir-element-determ-length-squared מהמשקל של כל דמות בסריג.

אנו רואים כעת את הבסיס הנ"ל

\begin{equation}
\{e^{2\pi\sqrt{-1}\bra{x}\lambda_i\rangle}/\sqrt{|\det A|}\}_{i=0}^\infty
\end{equation}

כדי להיות הבסיס שלנו פורייה ישימה משפטים של אורתונורמלי (תו מרובה) פונקציות (של ייצוג זה של (שלילי) Euclidean Casimir אלמנט) ישירות המקביל $\set{\lambda_i}$. לפי ההשערות של המשפט שלנו, אנחנו חייבים להיות $i < j \implies \lVert\lambda_i\rVert\leq \lVert\lambda_j\rVert$ (with the Euclidean norm on the weights).

עכשיו אנחנו יכולים לחשב

\begin{equation}
\label{eqn:a}
M^{i,j,k} = \begin{cases}
1/\sqrt{|\det A|} &amp; \lambda_i + \lambda_j - \lambda_k = 0 \\
0 &amp; \טקסט{otherwise}
\סוף{cases}
\end{equation}

כיוון שמשוואה זו ~\ref{eqn:a} אינה משתנה רק תחת טרנספורמציות לינאריות על סריג המשקל $(A^{-1})^t\mathbb{Z}^n = \set{\lambda_i}$, רק מפת בסיס של פונקציה עצמית אורתונורמלית $L^2$ הנגרמת ממפה לינארית הפיכה לשימור נפח בין שני סריגי משקל ממופתחים כאלה, דירוג $n$ ישמור על סל הנתונים הממופתח "אלגברי/טופולוגי" $\set{M^{i,j,k}$ אינו משתנה.

עם זאת, על מנת להחיל את המשפט ~\ref{thm}, זה חיוני כי מפה לינארית כזו $B$ להיות $B\in SO(n,\mathbb{R})$ על סריג המשקל, כי המושרה $L^2$ מפת בסיס פונקציה עצמית

\begin{equation}
\{e^{2\pi\sqrt{-1}\bra{x}B\lambda_i\rangle}/\sqrt{|\det A|}\}_{i=0}^\infty
\end{equation}

כמו כן, יש לשמור על הפולשים ה"אנליטיים" - האיור המושרש של קזימיר-אלמנט $4\pi^2\lVert\lambda_i\rVert^2$ לכל משקל ממופתח, כלומר, הערכים הילידים האינדיבידואליים של Laplacian של הטורי השטוח.

הייצוג-החשבון התיאורטי \cite{AK01} שווה בדיוק לפיתוח הקודם של \textit{lattice congruence} \cite{NRR22} המשמש באופן מסחרי לתיחום סיווגי איזומטריה של טורי שטוח. למעשה, המטריצה של מפה לינארית כזו $B\in SO(n,\mathbb{R})$, כפי שמתואר בפסקה הקודמת, \textbf{is} האיזומטריה הרימאנית המנוגדת בין הטורי, כפי שסופק על ידי
יישום משפט הייצוג של גלפנד-ניימארק במהלך הוכחת המשפט ~\ref{thm}.

\פסקה{אישור קבלה}
המחקר המקורי מומן בחלקו על ידי פרס ג'יימס סימונס למחקר אדיב בשנים 1995-1996, והתמיכה הנדיבה של אלפרד פ. מלגת דיסרטציה של סלואן בשנים 1996-1997 באוניברסיטת סטוני ברוק.

המחבר גם רוצה להודות לטניה כריסטיאנסן, קרולין גורדון, חמיד הזארי, חריש סשאדרי, ובמיוחד ליאון טכטאג'אן על עזרתם הטכנית וסקירתם בהכנת כתב היד הזה לפרסום.

