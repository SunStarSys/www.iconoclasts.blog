\begin{document}

\maketitle

\begin{abstract}
For a confining Schrödinger operator $H=-\Delta_g+V$ on a complete Riemannian manifold, isospectrality determines the eigenspaces only up to unitary mixing within each eigenvalue. We prove that a unitary spectral identification which also preserves the triple products $\Phi(u,v,w)=\int uvw\,d\mathrm{vol}$ is implemented by a diffeomorphism intertwining the metrics and the potentials. The same statement holds for Witten operators on $L^2(e^{-\varphi}\,d\mathrm{vol})$, with the weight recovered up to an additive constant. The geometric discriminant is the multiplication table on the spectral subspaces, not the spectrum by itself.

\noindent\textbf{Keywords:} spectrum, Fourier, harmonic, triple products, Schr\"odinger, Witten, Laplacian, eigenfunctions, functional, inverse problem
\end{abstract}

\tableofcontents

\section{Introduction}
\label{sec:intro}

Let $(M,g)$ be a smooth, connected, complete Riemannian manifold (possibly non-compact, possibly of infinite volume). Fix a real potential $V\in C^\infty(M)$ which is bounded below and proper in the sense
$$V(x)\to +\infty\qquad\text{as }x\to\infty$$
(i.e., $\{x:V(x)\le C\}$ is compact for every $C$). Let
$$H=-\Delta_g+V$$
be the associated Schr\"odinger operator, essentially self-adjoint on $C_c^\infty(M)$. Under these hypotheses it is classical that

$\sigma(H)=\sigma_{\mathrm{disc}}(H)=\{\lambda_0<\lambda_1\le\lambda_2\le\cdots\}\to+\infty$, each eigenvalue of finite multiplicity;
there is an orthonormal basis $\{e^i\}_{i=0}^\infty\subset L^2(M,d\mathrm{vol}_g)$ of smooth eigenfunctions,$$He^i=\lambda_i e^i.$$

(The same conclusions hold for $-\Delta_g$ itself on some complete manifolds of finite volume with no continuous spectrum, but the confining potential makes the analysis cleaner.)
Define the triple products exactly as in the compact case:
$$M^{i,j,k}:=\langle e^i e^j,e^k\rangle_{L^2}=\int_M e^i e^j\,\overline{e^k}\,d\mathrm{vol}_g.$$
Because the eigenfunctions are Schwartz-class at infinity in the sense that they and their derivatives decay faster than any polynomial in $V$ (Agmon estimates \cite{Agmon1982}/ weighted Sobolev \cite{TaylorPDE1} expressed in terms of $H$), the products $e^i e^j$ lie in $L^2$ and the integrals converge absolutely.

Now let
$$\mathcal{S}_M:=\bigoplus_{n=0}^\infty\ker(H_M-\lambda_n)$$
be the algebraic direct sum of the eigenspaces (a dense subspace of $L^2(M,d\mathrm{vol}_g)$, contained in $\mathcal{S}(M)\cap C_0(M)$ by elliptic regularity and Agmon decay). The same data $(N,h,W)$ produce $H_N$ and $\mathcal{S}_N$.

Pointwise multiplication and the $L^2$ inner product assemble into a symmetric trilinear form on the spectral subspace,
$$\Phi_M:\mathcal{S}_M\times\mathcal{S}_M\times\mathcal{S}_M\to\mathbb{C},\qquad
\Phi_M(u,v,w)=\int_M u\,v\,w\,d\mathrm{vol}_g.$$
A linear map $U:\mathcal{S}_M\to\mathcal{S}_N$ is a \textbf{spectral identification} if it is unitary for the $L^2$ inner products and
$$U\bigl(\ker(H_M-\lambda_n)\bigr)=\ker(H_N-\lambda_n)\qquad\text{for every }n.$$
(Existence of some spectral identification is exactly isospectrality with matching multiplicities.)

\subsection{Results}
\label{subsec:res}

\begin{theorem}
\label{thm}

Let $(M,g,V)$ and $(N,h,W)$ be as above, and suppose $H_M$ and $H_N$ are isospectral. If there exists a spectral identification $U:\mathcal{S}_M\to\mathcal{S}_N$ that intertwines the triple forms,
$$\Phi_N(Uu,Uv,Uw)=\Phi_M(u,v,w)\qquad\text{for all }u,v,w\in\mathcal{S}_M,$$
then there is a diffeomorphism $F:N\to M$ with
$$F^*g=h\qquad\text{and}\qquad V\circ F=W.$$

\end{theorem}

Equivalently, in basis coordinates we have the following

\begin{theorem}
\label{thm-2}
The same conclusion holds if there exist $L^2$-orthonormal eigenbases $\{e^i\}$ of $H_M$ and $\{f^i\}$ of $H_N$, ordered by nondecreasing eigenvalues, with
$$M_M^{i,j,k}=M_N^{i,j,k}\qquad\text{for all }i,j,k.$$
\end{theorem}

\begin{remark}
\label{rmk}
Theorem~\ref{thm-2} is the matrix form of Theorem~\ref{thm}. Given such bases, the map $Ue^i=f^i$ is a spectral identification, and
$$M^{i,j,k}=\Phi(e^i,e^j,\bar{e}^k).$$
Conversely, any spectral identification that intertwines $\Phi$ becomes Theorem~\ref{thm-2} after choosing orthonormal bases of each eigenspace and transporting them by $U$. The residual freedom in a spectral identification is $\prod_n\mathrm{U}(m_n)$; intertwining $\Phi$ is the condition that cuts that product down to an isometry of $(M,g,V)$ with $(N,h,W)$.
\end{remark}

Let $(M,g)$ be complete and connected, and let $\varphi\in C^\infty(M)$ be confining in the Bakry–Émery sense, so that the Witten operator
$$L_\varphi u=-\Delta_g u+\langle\nabla\varphi,\nabla u\rangle$$
is essentially self-adjoint and bounded below on $C_c^\infty(M)$, with
$$\sigma(L_\varphi)=\sigma_{\mathrm{disc}}(L_\varphi)=\{\nu_0=0<\nu_1\le\nu_2\le\cdots\}\to+\infty$$
in the weighted space $L^2(M,e^{-\varphi}\,d\mathrm{vol}_g)$. Write
$$\mathcal{S}_\varphi:=\bigoplus_{n=0}^\infty\ker(L_\varphi-\nu_n)\subset L^2(M,e^{-\varphi}\,d\mathrm{vol}_g)\cap C_0(M).$$
The same data $(N,h,\psi)$ produce $L_\psi$ and $\mathcal{S}_\psi$.
The invariant is the weighted triple form
$$\Phi_\varphi:\mathcal{S}_\varphi\times\mathcal{S}_\varphi\times\mathcal{S}_\varphi\to\mathbb{C},\qquad
\Phi_\varphi(u,v,w)=\int_M u\,v\,w\,e^{-\varphi}\,d\mathrm{vol}_g.$$
A linear map $U:\mathcal{S}_\varphi\to\mathcal{S}_\psi$ is a spectral identification if it is unitary for the weighted $L^2$ inner products and
$$U\bigl(\ker(L_\varphi-\nu_n)\bigr)=\ker(L_\psi-\nu_n)\qquad\text{for every }n.$$

\begin{corollary}
\label{coro}
Let $(M,g,\varphi)$ and $(N,h,\psi)$ be as above, and assume $L_\varphi$ and $L_\psi$ are isospectral. If there exists a spectral identification $U:\mathcal{S}_\varphi\to\mathcal{S}_\psi$ such that
$$\Phi_\psi(Uu,Uv,Uw)=\Phi_\varphi(u,v,w)\qquad\text{for all }u,v,w\in\mathcal{S}_\varphi,$$
then there is a diffeomorphism $F:N\to M$ with
$$F^*g=h\qquad\text{and}\qquad\psi=\varphi\circ F+c$$
for a constant $c\in\mathbb{R}$. In particular the weighted manifolds $(M,g,e^{-\varphi}\mathrm{vol}_g)$ and $(N,h,e^{-\psi}\mathrm{vol}_h)$ are isometric up to that constant rescaling of the weight.
\end{corollary}
In basis coordinates, we again have
\begin{corollary}
\label{coro-2}
The same conclusion holds if there exist weighted-orthonormal eigenbases $\{f^i\}$ of $L_\varphi$ and $\{u^i\}$ of $L_\psi$, ordered by nondecreasing eigenvalues, with
$$W^{ij,k}:=\int_M f^i f^j\overline{f^k}\,e^{-\varphi}\,d\mathrm{vol}_g
=\int_N u^i u^j\overline{u^k}\,e^{-\psi}\,d\mathrm{vol}_h
\qquad\text{for all }i,j,k.$$
\end{corollary}

\begin{remark}
The Witten Laplacian on $p$-forms is the Hodge Laplacian of the weighted manifold plus $t\operatorname{Hess}\varphi\#_p+t^2\lvert\nabla\varphi\rvert^2$. Once $(M,g,\varphi)$ is reconstructed from the scalar array $W^{i,j,k}$, the operators $L_{\varphi}^{(p)}$ are determined, so their spectra and eigenform pairings against scalar eigenfunctions are invariants, not additional moduli.
\end{remark}
\section{Preliminaries}
\label{sec:pre}

Let $\mathcal{A}_0\subset L^2(M)$ be the algebraic span of the eigenfunctions. Finite linear combinations
$$\phi=\sum_{i=0}^N\hat\phi(i)\,e^i$$ are dense in $L^2$ and, by elliptic regularity plus the decay of eigenfunctions, lie in $C^\infty\cap C_0(M)$. Pointwise multiplication is
$$\phi\psi=\sum_k\Bigl(\sum_{i,j}\hat\phi(i)\hat\psi(j)M^{i,j,k}\Bigr)e^k.$$
Thus the structure constants determine the product of any two finite eigenfunction expansions. The same identity holds on $N$. Consequently the linear map
$$\vec F:\mathcal{A}_0(M)\to\mathcal{A}_0(N),\qquad e^i\mapsto f^i$$
is an algebra homomorphism for pointwise multiplication (the constant function is a multiple of the ground state only if $V$ is constant; in general $\vec F$ need not send $1$ to $1$, but it preserves the product of any two functions that can be so expanded).
This is identical to the compact calculation; the only extra ingredient is that the eigenfunction expansion of a compactly supported smooth function still converges rapidly enough for the triple-product formula to be justified (which follows from the same elliptic estimates that give $\lambda_i^{N}\|e^i\|_\infty\to 0$ locally, plus Agmon decay at infinity).

\subsection{Gamma Calculus}
By definition \cite{BE85}
$$\Gamma_H(f,g):=\frac12\bigl(H(fg)-f\,Hg-g\,Hf\bigr).$$
On basis vectors this is already diagonal in the spectrum:
$$\Gamma_H(e^i,e^j)=\frac12\sum_k(\lambda_k-\lambda_i-\lambda_j)\,M^{i,j,k}\,e^k.$$
Hence
$$\begin{aligned}
\langle\nabla e^i,\nabla e^j\rangle
&=-\Gamma_H(e^i,e^j)-\frac12 V e^i e^j\\
&=-\frac12\sum_k[(\lambda_k-\lambda_i-\lambda_j)M^{i,j,k} +\int V e^i e^j \bar e^k\, dx]\, e^k.
\end{aligned}$$

Ground-state conjugation repairs the $V$ defect: if $H\psi=\lambda_0\psi$ with $\psi>0$ (which is always available under our given hypotheses), then

$$L:=\psi^{-1}(H-\lambda_0)(\psi\,\cdot\,)=-\Delta-2\langle\nabla\log\psi,\nabla\,\cdot\,\rangle$$
is a diffusion, and its Bakry–Émery tensor is $\mathrm{Ric}_L=\operatorname{Ric}-2\operatorname{Hess}\log\psi$. For the harmonic oscillator the ground state is a Gaussian, $\log\psi_0=-x^2/2+\mathrm{const}$, and one recovers exactly $\mathrm{BE}(2,\infty)$ for this renormalized Ornstein–Uhlenbeck process — the classical diffusion underneath the quantum oscillator. In particular, $\mathrm{Ric}_L\ge K g$ implies the spectral gap bound $\lambda_1-\lambda_0\ge K$, with equality for the harmonic oscillator.

With $\phi =- 2 \log \psi_0$ and $v\cdot w$ the Riemannian cometric, let us write these operators in the eigenbasis of $L$,

\begin{equation}
\begin{aligned}
f_n&=\frac{\psi_n}{\psi_0},\qquad
 W^{i,j,k}=\int\frac{\psi_i\psi_j\psi_k}{\psi_0}\,d\mathrm{vol},\\
\Gamma_L(f_i,f_j):&=\frac12\sum_k(\lambda_k+\lambda_0-\lambda_i-\lambda_j)W^{i,j,k}\,f_k = -df_i \cdot df_j\\
\Gamma_{2,L}(f_i,f_j):&=\frac14\sum_k(\lambda_k+\lambda_0-\lambda_i-\lambda_j)^2 W^{i,j,k}\,f_k\implies\\
\Gamma_{2,L}(f)&=\lvert\operatorname{Hess}f\rvert_{\mathrm{HS}}^2+\operatorname{Ric}(\nabla f,\nabla f) + \operatorname{Hess}\phi(\nabla f, \nabla f).
\end{aligned}
\end{equation}

For a Schr\"odinger operator as in the Theorem~\ref{thm}, the isometric type of $(M,g,V)$ is encoded in the diffusion data $(\{\lambda_n-\lambda_0\},\{W^{i,j,k}\})$, because $\Gamma_L$ is the cometric and $\psi_0$ recovers $V$ by Riccati.

\section{Proof of Theorems}
\begin{proof}
(Following \cite{JS24}) For sufficiency, we now consider the linear, bijective orthonormal eigenfunction basis map $\vec{F}$ from $\mathcal{S}_M$ to $\mathcal{S}_N$ and note that from the calculations in Section~\ref{sec:pre} above, $\vec{F}$ preserves pointwise products for such smooth functions by the premise that $\set{M^{i,j,k}}$ is invariant under this map.

\begin{lemma}
\label{lma}
$\vec F$ preserves the uniform norm on the span of the eigenfunctions, hence extends to an isometric $*$-homomorphism
$$\vec F:C_0(M)\supset\overline{\mathcal{A}_0}^{\|\cdot\|_\infty}\longrightarrow C_0(N).$$
\end{lemma}

\begin{subproof}[Proof of Lemma~\ref{lma}]
Eigenfunctions may be taken real, so $\mathcal{A}_0$ is a real algebra (without unit) in $C^\infty\cap C_0\cap L^2$. Matching triple products make $\vec F:\mathcal{A}_0(M)\to\mathcal{A}_0(N)$ an algebra homomorphism, and the spectral identification makes it unitary for $L^2$.
Products stay in $\mathcal{A}_0$. If $\phi=\sum_i\hat\phi(i)\,e^i\in\mathcal{A}_0$, the structure-constant formula of §2 gives $\phi^p\in\mathcal{A}_0$ for every integer $p\ge 1$, and
$$\vec F(\phi^p)=(\vec F\phi)^p.$$
$L^{2p}$ norms are preserved. Unitarity on $L^2$ therefore yields
$$\|\phi\|_{L^{2p}(M)}^{2p}=\langle\phi^p,\phi^p\rangle_{L^2(M)}=\langle(\vec F\phi)^p,(\vec F\phi)^p\rangle_{L^2(N)}=\|\vec F\phi\|_{L^{2p}(N)}^{2p}.$$

$L^{2p}$ recovers $\|\cdot\|_\infty$ on $C_0\cap L^2$. Let $\phi\in C_0(M)\cap L^2(M)$ and write $m=\|\phi\|_\infty$. The function $|\phi|$ attains the value $m$ on a compact set (one-point compactification: the maximum is not at infinity unless $\phi=0$). For $0<\delta<m$ the set
$$E_\delta=\{x:|\phi(x)|\ge m-\delta\}$$
is compact and nonempty, hence of finite volume. Then
$$(m-\delta)^{2p}\mathrm{vol}(E_\delta)\le\int_M|\phi|^{2p}\,d\mathrm{vol}\le m^{2p-2}\|\phi\|_{L^2}^2,$$
so
$$(m-\delta)\,\mathrm{vol}(E_\delta)^{1/(2p)}\le\|\phi\|_{L^{2p}}\le m^{1-1/p}\|\phi\|_{L^2}^{1/p}.$$
The right side tends to $m$ and the left side tends to $m-\delta$. Letting $\delta\downarrow 0$ gives
$$\lim_{p\to\infty}\|\phi\|_{L^{2p}}=\|\phi\|_\infty.$$
The same identity holds on $N$.

For $\phi\in\mathcal{A}_0$,
$$\|\vec F\phi\|_\infty=\lim_p\|\vec F\phi\|_{L^{2p}}=\lim_p\|\phi\|_{L^{2p}}=\|\phi\|_\infty.$$
Thus $\vec F$ is isometric for $\|\cdot\|_\infty$ on a dense subspace of its uniform closure. The closure of $\mathcal{A}_0$ in $C_0(M)$ is a commutative $C^*$-subalgebra of $C_0(M)$, and $\vec F$ extends uniquely to an isometric $*$-homomorphism into $C_0(N)$. Self-adjointness is immediate: eigenfunctions are real.
\end{subproof}

Since $\mathcal A_0$ separates points and has an element that vanishes nowhere $(\psi_0)$, Stone-Weierstrass \cite{JC19} proves its closure is exactly $C_0(M)$. Running that argument in reverse gives the same result on $C_0(N)$. Now we apply the Gelfand-Naimark Representation Theorem (in contravariant functor form) for Abelian $C^*$ algebras $C_0(N), C_0(M)$ \cite{JC19} to represent this isomorphism $\vec{F}$ by a homeomorphism $F$ between $N$ and $M$.

\begin{lemma}
\label{lma-smooth}
$F$ is a $C^\infty$ diffeomorphism, and $F^*g=h$.
\end{lemma}
\begin{subproof}
Let $f_n=\psi_n/\psi_0$ and let $\mathcal{A}_0$ be their algebraic span. $f_n$ need not be in $C_0(M)$; so we let
$$U\psi_n=\psi_n\circ F,\qquad U\psi_0=\psi_0\circ F>0,$$
hence
$$f_n\circ F=\frac{\psi_n\circ F}{\psi_0\circ F}=\frac{U\psi_n}{U\psi_0}.$$
Define $Uf_n:=U\psi_n/U\psi_0$.
Then $Uf=f\circ F$ on $\mathcal{A}_0$, and $\Gamma_L(f_i,f_j)=-df_i\cdot df_j$ as in (1). Note $f_0\equiv 1$, so coordinates come from $\{f_n\}_{n\ge 1}$.
Fix $p\in M$. The finite spectral projectors of $L$ send $C_c^\infty(M)$ into $\mathcal{A}_0$ and converge in $C^\infty_{\mathrm{loc}}$ (elliptic regularity). Hence $\mathcal{A}_0$ is dense in $C^1$ on a neighborhood of $p$. If $\operatorname{span}\{\nabla f_n(p):n\ge 1\}\ne T_pM$, there would exist $0\neq v\in T_pM$ with $df_n(v)=0$ for every $n$, hence $d\phi(v)=0$ for every $\phi\in\mathcal{A}_0$. Taking a $C^1$-limit would give $du(v)=0$ for every $u\in C_c^\infty$, which is absurd. Thus some $d$-tuple satisfies
$$\det\bigl(\Gamma_L(f_{i_a},f_{i_b})(p)\bigr)\ne 0.$$
The indices may depend on $p$; every point has such a tuple.
Those $d$ functions are a $C^\infty$ chart $x=(f_{i_1},\dots,f_{i_d})$ on a neighborhood of $p$. The same indices work at $F^{-1}(p)$ because $U$ preserves $\Gamma_L$. The matching chart on $N$ is $y=(Uf_{i_1},\dots,Uf_{i_d})$, and $Uf=f\circ F$ says $y=x\circ F$. So $F$ is the identity map of $\mathbb{R}^d$ in these charts, hence a $C^\infty$ diffeomorphism near $p$. The cometric coefficients are
$$g^{ab}=-\Gamma_L(f_{i_a},f_{i_b}),$$
finite eigenfunction expansions by (1). Applying $U$ gives $F^*g=h$ near $p$. The point $p$ was arbitrary.
\end{subproof}

Now since $F$ intertwines $H$, the second-order parts already agree, so the order-zero terms give $V\circ F=W$

This completes the proof of the Theorem~\ref{thm-2}. Theorem~\ref{thm} is a consequence of Theorem~\ref{thm-2} and Remark~\ref{rmk}.
\end{proof}

\begin{subproof}[Proof of Corollary~\ref{coro}]
Assume a spectral identification $U:\mathcal{S}_\varphi\to\mathcal{S}_\psi$ with
$$\Phi_\psi(Uu,Uv,Uw)=\Phi_\varphi(u,v,w).$$
Pointwise products expand in the weighted eigenbasis by $\Phi_\varphi$, so $U(fg)=U(f)U(g)$ on finite combinations. The same cutoff argument as Lemma 7, using sublevel sets of $\varphi$ (or of a confining exhaustion), shows $U$ preserves $\|\cdot\|_\infty$ and extends to a $*$-isomorphism
$$U:C_0(M)\supset\overline{\mathcal{S}_\varphi}^{\,\infty}\longrightarrow
\overline{\mathcal{S}_\psi}^{\,\infty}\subset C_0(N).$$

Gelfand–Naimark \cite{JC19} gives a homeomorphism $F:N\to M$ with $Uf=f\circ F$. Smoothness of $F$ and $F^*g=h$ follows from Lemma~\ref{lma-smooth}, where the Witten eigenfunctions play the role of the $\set{f_n}$.

The first-order terms are the drifts
$$L_\varphi=-\Delta_g+\mathrm{grad}_g\varphi\,\lrcorner\,d,\qquad
L_\psi=-\Delta_h+\mathrm{grad}_h\psi\,\lrcorner\,d.$$
Pulling back gives $d\psi=F^*d\varphi$, so $\psi=\varphi\circ F+c$.

This completes the proof. Corollary~\ref{coro-2} is a coordinate restatement of it, so no additional proof provided.
\end{subproof}

\section{Example}
On $M=\mathbb{R}$ with the Euclidean metric, take
$$H=-\frac{d^2}{dx^2}+x^2.$$
The potential $V(x)=x^2$ is smooth, bounded below, and $V(x)\to+\infty$ as $|x|\to\infty$. Hence $\sigma_{\mathrm{ess}}(H)=\emptyset$. The spectrum is
$$\lambda_n=2n+1,\qquad n=0,1,2,\dots$$
(each of multiplicity one). The corresponding $L^2(\mathbb{R})$-normalized eigenfunctions are the Hermite functions
$$\psi_n(x)=\bigl(2^n n!\,\sqrt{\pi}\bigr)^{-1/2}H_n(x)\,e^{-x^2/2},$$
where $H_n$ are the physicist’s Hermite polynomials. They form an orthonormal basis of $L^2(\mathbb{R})$, lie in the Schwartz class $\mathcal{S}(\mathbb{R})\subset C_0(\mathbb{R})$, and satisfy the Agmon decay that makes every pointwise product $\psi_i\psi_j$ square-integrable.
\subsection{Triple products}
Because the eigenfunctions are real,
$$M^{i,j,k}=\langle\psi_i\psi_j,\psi_k\rangle=\int_{-\infty}^{\infty}\psi_i(x)\psi_j(x)\psi_k(x)\,dx.$$
These integrals vanish unless $i+j+k$ is even (parity) and the three indices satisfy a triangle-type constraint coming from the linearization of Hermite polynomials. The linearization formula
$$H_n(x)H_m(x)=\sum_{r=0}^{\min(n,m)}\binom{n}{r}\binom{m}{r}r!\,2^r\,H_{n+m-2r}(x)$$
together with the Gaussian weight converts, after normalizing, into an explicit formula for $M^{i,j,k}$. Equivalently, the generating-function identity
$$\int_{-\infty}^{\infty}e^{-x^2}H_a(x)H_b(x)H_c(x)\,dx
=\sqrt{\pi}\,2^N\frac{a!\,b!\,c!}{(N-a)!(N-b)!(N-c)!}$$
(when $a+b+c=2N$ is even and each factorial in the denominator is defined and non-negative, and $0$ otherwise) yields $M^{i,j,k}$ after inserting the normalization constants of the $\psi_n$. In particular:

$M^{n,n,0}=\int\psi_n^2\psi_0\,dx>0$ (the ground state $\psi_0=\pi^{-1/4}e^{-x^2/2}$ is a strictly positive Gaussian);
the map $\psi_i\psi_j=\sum_k M^{i,j,k}\psi_k$ is the exact multiplication rule in the Hermite basis.

So the structure constants of pointwise multiplication on the dense subspace $\mathrm{span}\{\psi_n\}\subset C_0(\mathbb{R})$ are known in closed form.
\subsection{What the theorem says}
Suppose $(\mathbb{R},g,W)$ is another complete Riemannian line (so $g=e^{2\phi(x)}\,dx^2$ in some coordinate) with a smooth confining potential $W$, and suppose its Schrödinger operator $-\Delta_g+W$ is isospectral to $H$ and admits an eigenbasis $\{f_n\}$ with the same triple products
$$\langle f_i f_j,f_k\rangle=M^{i,j,k}.$$
The discrete-spectrum argument then produces a diffeomorphism $F:\mathbb{R}\to\mathbb{R}$ such that
$$F^*g=dx^2,\qquad W\circ F=x^2.$$
In one dimension this is almost tautological once the algebra is identified, but the mechanism is visible by hand:

Finite Hermite combinations are dense in $C_0(\mathbb{R})$ for the uniform norm (Stone–Weierstrass on each compact plus Gaussian decay at infinity).
The numbers $M^{i,j,k}$ determine the product of any two such combinations, hence determine a $C^*$-isomorphism$$C_0(\mathbb{R})\longrightarrow C_0(\mathbb{R}),\qquad \psi_n\mapsto f_n.$$
Gelfand–Naimark supplies a homeomorphism of the underlying locally compact spaces; Lemma~\ref{lma-smooth} smooths it up to a Riemannian isometry.

Because every eigenspace is one-dimensional, the singular-value packaging collapses to the absolute values $|M^{i,j,k}|$ together with a consistent choice of signs (the “diagonal litmus” of the compact paper: the products $M^{i,i,k}$ determine the even part of the algebra and fix most signs).

\subsection{Explicit Formula}
$$M^{i,j,k}=\langle\psi_i\psi_j,\psi_k\rangle
=\int_{\mathbb{R}}\psi_i(x)\psi_j(x)\psi_k(x)\,dx
=N_i N_j N_k\int_{\mathbb{R}}H_i(x)H_j(x)H_k(x)\,e^{-3x^2/2}\,dx,$$
where $N_n=(2^n n!\sqrt{\pi})^{-1/2}$.

$M^{i,j,k}=0$ unless both of the following hold -- parity: $i+j+k$ is even; triangle: $|i-j|\le k\le i+j$ (and cyclic permutations).

These are the oscillator analogues of the Clebsch–Gordan support conditions.

Change variables $x=\sqrt{2/3}\,y$. Then
$$\int_{\mathbb{R}}H_i(x)H_j(x)H_k(x)\,e^{-3x^2/2}\,dx
=\sqrt{\frac{2}{3}}\int_{\mathbb{R}}H_i\Bigl(\sqrt{\tfrac{2}{3}}\,y\Bigr)
H_j\Bigl(\sqrt{\tfrac{2}{3}}\,y\Bigr)
H_k\Bigl(\sqrt{\tfrac{2}{3}}\,y\Bigr)\,e^{-y^2}\,dy.$$
Each scaled polynomial expands by the finite identity
$$H_n(\gamma y)=\sum_{\ell=0}^{\lfloor n/2\rfloor}\gamma^{n-2\ell}(\gamma^2-1)^\ell\binom{n}{2\ell}\frac{(2\ell)!}{\ell!}\,H_{n-2\ell}(y),$$
with $\gamma=\sqrt{2/3}$. The product of the three expansions is a finite linear combination of products $H_a H_b H_c$. Titchmarsh’s formula \cite{T48} then evaluates every remaining integral:
$$\int_{\mathbb{R}}H_a H_b H_c\,e^{-y^2}\,dy
=
\begin{cases}
\dfrac{\sqrt{\pi}\,2^{s}\,a!\,b!\,c!}{(s-a)!(s-b)!(s-c)!}
& \text{if }a+b+c=2s\text{ is even and }s\ge a,b,c,\\
0 & \text{otherwise.}
\end{cases}$$
The result is a finite triple sum (at most $O(ijk)$ terms, typically far fewer). Combining the prefactors $N_i N_j N_k\sqrt{2/3}$ gives $M^{i,j,k}$ exactly.

Equivalently, the product of two normalized functions expands in a scaled Hermite basis
$$\psi_i(x)\psi_j(x)=\sum_{r=0}^{\lfloor(i+j)/2\rfloor}c_{r;ij}\,\psi_{i+j-2r}(\sqrt{2}\,x),$$
with explicit coefficients
$$c_{r;ij}
=\frac{(-1)^r}{\sqrt{2^{i+j-2r+1}\pi}}
\sqrt{\frac{(i+j-2r)!}{i!\,j!}}
\binom{i}{r}\binom{j}{r}r!\,2^{r}$$
(up to the conventional placement of the $\sqrt{2}$ in the argument; cf. \cite{K16}). Then
$$M^{i,j,k}=\sum_{r}c_{r;ij}\int_{\mathbb{R}}\psi_{i+j-2r}(\sqrt{2}\,x)\,\psi_k(x)\,dx,$$
and each scaled overlap is a ${}_2F_1$ (or terminates as a short hypergeometric sum).

With $f_n=\psi_n/\psi_0$ and $d\mu=\psi_0^2\,dx$,
$$W^{i,j,k}=\int_{\mathbb{R}}\frac{\psi_i\psi_j\psi_k}{\psi_0}\,dx
=\frac{N_i N_j N_k}{N_0}\int H_i H_j H_k\,e^{-x^2}\,dx.$$
Titchmarsh \cite{T48} then collapses to
$$W^{i,j,k}
=
\frac{\sqrt{i!\,j!\,k!}}{(s-i)!(s-j)!(s-k)!}
\quad\text{when }i+j+k=2s\text{ and }s\ge i,j,k,$$
and $0$ otherwise. In particular $W^{0,n,n}=1$, which is orthonormality of $\{\psi_n\}$ in $L^2(dx)$.

As these structure constants are non-negative on a multiplicity-1 spectrum, they are the associated singular-value invariants \cite{JS24} for $L$.

