\maketitle

\begin{abstract}
Using elementary techniques from Geometric Analysis, Partial Differential Equations, and Abelian $C^*$ Algebras, we uncover a novel, yet familiar, global geometric discriminant -- namely the indexed set of integrals of triple products of eigenfunctions of the Schr\"odinger operator, to precisely characterize which isospectral Schr\"odinger Operators are isometric.

\noindent\textbf{Keywords:} spectrum, Fourier, harmonic, triple products, Schr\"odinger, eigenfunctions, functional, inverse problem, representation theory
\end{abstract}

\tableofcontents

\section{Introduction}
\label{sec:intro}

Let $(M,g)$ be a smooth, connected, complete Riemannian manifold (possibly non-compact, possibly of infinite volume). Fix a real potential $V\in C^\infty(M)$ which is bounded below and proper in the sense
$$V(x)\to +\infty\qquad\text{as }x\to\infty$$
(i.e., $\{x:V(x)\le C\}$ is compact for every $C$). Let
$$H=-\Delta_g+V$$
be the associated Schr\"odinger operator, essentially self-adjoint on $C_c^\infty(M)$. Under these hypotheses it is classical that

$\sigma(H)=\sigma_{\mathrm{disc}}(H)=\{\lambda_0\le\lambda_1\le\lambda_2\le\cdots\}\to+\infty$, each eigenvalue of finite multiplicity;
there is an orthonormal basis $\{e^i\}_{i=0}^\infty\subset L^2(M,d\mathrm{vol}_g)$ of smooth eigenfunctions,$$He^i=\lambda_i e^i.$$

(The same conclusions hold for $-\Delta_g$ itself on some complete manifolds of finite volume with no continuous spectrum, but the confining potential makes the analysis cleaner.)
Define the triple products exactly as in the compact case:
$$M^{i,j,k}:=\langle e^i e^j,e^k\rangle_{L^2}=\int_M e^i e^j\,\overline{e^k}\,d\mathrm{vol}_g.$$
Because the eigenfunctions are Schwartz-class at infinity in the sense that they decay faster than any polynomial in $V$ (Agmon estimates / weighted Sobolev), the products $e^i e^j$ lie in $L^2$ and the integrals converge absolutely.

\subsection{Results}
\label{subsec:res}

\begin{theorem}
\label{thm}

Let $(M,g,V)$ and $(N,h,W)$ be two such data, with isospectral Schrödinger operators $H_M$ and $H_N$. Suppose there exist orthonormal eigenbases $\{e^i\}$ of $H_M$ and $\{f^i\}$ of $H_N$, ordered by non-decreasing eigenvalues, such that
\begin{equation}
M_M^{i,j,k}=M_N^{i,j,k}\qquad\forall\qquad i,j,k.
\end{equation}
Then there is a diffeomorphism $F:N\to M$ with $F^*g=h$ and $V\circ F=W$.
\end{theorem}

\section{Preliminaries}
\label{sec:pre}

Let $\mathcal{A}_0\subset L^2(M)$ be the algebraic span of the eigenfunctions. Finite linear combinations
$$\phi=\sum_{i=0}^N\hat\phi(i)\,e^i$$ are dense in $L^2$ and, by elliptic regularity plus the decay of eigenfunctions, lie in $C^\infty\cap C_0(M)$. Pointwise multiplication is
$$\phi\psi=\sum_k\Bigl(\sum_{i,j}\hat\phi(i)\hat\psi(j)M^{i,j,k}\Bigr)e^k.$$
Thus the structure constants determine the product of any two finite eigenfunction expansions. The same identity holds on $N$. Consequently the linear map
$$\vec F:\mathcal{A}_0(M)\to\mathcal{A}_0(N),\qquad e^i\mapsto f^i$$
is a unital algebra homomorphism for pointwise multiplication (the constant function is a multiple of the ground state only if $V$ is constant; in general $\vec F$ need not send $1$ to $1$, but it preserves the product of any two functions that can be so expanded). Characteristic functions of sublevel sets of $V$ can be approximated in $L^2$ by functional calculus of $H$, so $\vec F$ also preserves characteristic functions of sets of finite measure in the $L^2$ sense.
This is identical to the compact calculation; the only extra ingredient is that the eigenfunction expansion of a compactly supported smooth function still converges rapidly enough for the triple-product formula to be justified (which follows from the same elliptic estimates that give $\lambda_i^{N}\|e^i\|_\infty\to 0$ locally, plus Agmon decay at infinity).

\section{Proof of Theorem}
\begin{proof}
(Following \cite{JS24}) For sufficiency, we now consider the linear, bijective orthonormal eigenfunction basis map $\vec{F}$ from $C^\infty(M)$ to $C^\infty(N)$ and note that from the calculations in Section~\ref{sec:pre} above, $\vec{F}$ preserves pointwise products for smooth functions (and preserves characteristic functions when extended to $L^2(M,g)$) by the premise that $\set{M^{i,j,k}}$ is invariant under this map.

\begin{lemma}
\label{lma}
 $\vec F$ preserves the uniform norm on the span of the eigenfunctions, hence extends to an isometric $*$-homomorphism
$$\vec F:C_0(M)\supset\overline{\mathcal{A}_0}^{\|\cdot\|_\infty}\longrightarrow C_0(N).$$
\end{lemma}

\begin{subproof}[Proof of Lemma~\ref{lma}]
On a compact manifold one uses a smooth partition of unity and the fact that $\|a\|_\infty=1$ for a partition function $a$ is detected by $\|a^p\|_\infty=1$ for all $p$, which is visible in the Fourier coefficients because the limiting characteristic function of $\{a=1\}$ has $L^2$-mass.
In the non-compact setting replace a global partition of unity by a sequence of cutoffs $\chi_R$ that equal $1$ on $\{V\le R\}$ and vanish outside $\{V\le R+1\}$. On each such “almost-compact” region the same argument applies: if $\|\phi\|_\infty=c$ is attained on a set of positive measure inside $\{V\le R\}$, the powers $\phi^p/\|\phi\|_\infty^p$ converge in $L^2_{\mathrm{loc}}$ to a characteristic function, and $\vec F$ preserves that limit because it preserves all triple products. Sending $R\to\infty$ and using that every function in $C_0(M)$ is uniformly small outside a large sublevel set of $V$ gives $\|\vec F(\phi)\|_\infty=\|\phi\|_\infty$.

\end{subproof}

Now we apply the Gelfand-Naimark-Segal Representation Theorem (in contravariant functor form) for Abelian $C^*$ algebras $C_0(N), C_0(M)$ \cite{JC19} to represent this isomorphism $\vec{F}$ by a homeomorphism $F$ between $N$ and $M$. Since $\vec{F}$ is bijective on smooth functions, $F$ too must be smooth.

As this now diffeomorphism preserves eigenvalues and eigenfunctions (by hypothesis on $\vec{F}(f) = f \circ F$), it must preserve the Schr\"odinger operator on smooth functions. By construction
$$\vec F(\phi)=\phi\circ F$$
on the eigenbasis, hence on all finite combinations. Therefore
$$H_N(\phi\circ F)=(H_M\phi)\circ F$$
for every eigenfunction $\phi$, and by density for every Schwartz-class function. In particular $F$ pulls eigenfunctions of $H_M$ back to eigenfunctions of $H_N$ with the same eigenvalues.
Writing $H=-\Delta+V$ in local coordinates, the principal symbol of $H$ is the same as that of $-\Delta$, namely the cometric $g^{ij}\xi_i\xi_j$. An elliptic operator that is intertwined by a diffeomorphism has its principal symbol pulled back. Hence
$$F^*g=h.$$
The zeroth-order terms then give $V\circ F=W$.

This completes the proof of the Theorem.

\end{proof}


