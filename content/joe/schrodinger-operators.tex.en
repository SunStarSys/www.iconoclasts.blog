\begin{document}

\maketitle

\begin{abstract}
For a confining Schrödinger operator $H=-\Delta_g+V$ on a complete Riemannian manifold, the spectrum determines the eigenspaces only up to independent unitaries on each eigenspace. We prove that a spectral identification which also preserves the triple products
$$\Phi(u,v,w)=\int uvw\,d\mathrm{vol}$$
is implemented by a diffeomorphism $F$ with $F^*g=h$ and $V\circ F=W$. The same statement holds for Witten operators on $L^2(e^{-\alpha}\,d\mathrm{vol})$: the metric is recovered, and the weight is recovered up to an additive constant. Thus the geometric invariant is the multiplication table on the spectral subspaces, not the spectrum alone.

\noindent\textbf{Keywords:} spectrum, triple products, Schr\"odinger, Witten, Laplacian, eigenfunctions, inverse problem
\end{abstract}

\tableofcontents

\section{Introduction}
\label{sec:intro}

Let $(M,g)$ be a smooth, connected, complete Riemannian manifold (possibly non-compact, possibly of infinite volume). Fix a real potential $V\in C^\infty(M)$ which is bounded below and proper in the sense
$$V(x)\to +\infty\qquad\text{as }x\to\infty$$
(i.e., $\{x:V(x)\le C\}$ is compact for every $C$). Let
$$H=-\Delta_g+V$$
be the associated Schr\"odinger operator, essentially self-adjoint on $C_c^\infty(M)$. Under these hypotheses it is classical that

$\sigma(H)=\sigma_{\mathrm{disc}}(H)=\{\lambda_0<\lambda_1\le\lambda_2\le\cdots\}\to+\infty$, each eigenvalue of finite multiplicity;
there is an orthonormal basis $\{\psi_i\}_{i=0}^\infty\subset L^2(M,d\mathrm{vol}_g)$ of smooth eigenfunctions,$$H\psi_i=\lambda_i \psi_i.$$

(The same conclusions hold for $-\Delta_g$ itself on some complete manifolds of finite volume with no continuous spectrum, but the confining potential makes the analysis cleaner.)
Define the triple products exactly as in the compact case:
$$M^{i,j,k}:=\langle \psi_i \psi_j,\psi_k\rangle_{L^2}=\int_M \psi_i \psi_j\,\overline{\psi_k}\,d\mathrm{vol}_g.$$
Because the eigenfunctions are Schwartz-class at infinity in the sense that they and their derivatives decay faster than any polynomial in $V$ (Agmon estimates \cite{Agmon1982}/ weighted Sobolev \cite{TaylorPDE1} expressed in terms of $H$), the products $\psi_i \psi_j$ lie in $L^2$ and the integrals converge absolutely.

Now let $$\mathcal{A}_M:=\bigoplus_{n=0}^\infty\ker(H_M-\lambda_n)$$ be the algebraic direct sum of the eigenspaces (a dense subspace of $L^2(M,d\mathrm{vol}_g)$, contained in the Schwartz space $\mathcal{S}(M)$ by elliptic regularity and Agmon decay). The same data $(N,h,W)$ produce $H_N$ and $\mathcal{A}_N$.

Pointwise multiplication and the $L^2$ inner product assemble into a symmetric trilinear form on the spectral subspace,
$$\Phi_M:\mathcal{A}_M\times\mathcal{A}_M\times\mathcal{A}_M\to\mathbb{C},\qquad
\Phi_M(u,v,w)=\int_M u\,v\,w\,d\mathrm{vol}_g.$$
A linear map $U:\mathcal{A}_M\to\mathcal{A}_N$ is a \textbf{spectral identification} if it is unitary for the $L^2$ inner products and
$$U\bigl(\ker(H_M-\lambda_n)\bigr)=\ker(H_N-\lambda_n)\qquad\text{for every }n.$$
(Existence of some spectral identification is exactly isospectrality with matching multiplicities.)

\subsection{Results}
\label{subsec:res}

\begin{theorem}
\label{thm}

Let $(M,g,V)$ and $(N,h,W)$ be as above, and suppose $H_M$ and $H_N$ are isospectral. If there exists a spectral identification $U:\mathcal{A}_M\to\mathcal{A}_N$ that intertwines the triple forms,
$$\Phi_N(Uu,Uv,Uw)=\Phi_M(u,v,w)\qquad\text{for all }u,v,w\in\mathcal{A}_M,$$
then there is a diffeomorphism $F:N\to M$ with
$$F^*g=h\qquad\text{and}\qquad V\circ F=W.$$

\end{theorem}

Equivalently, in basis coordinates we have the following

\begin{theorem}
\label{thm-2}
The same conclusion holds if there exist $L^2$-orthonormal eigenbases $\{\psi_i\}$ of $H_M$ and $\{\eta_i\}$ of $H_N$, ordered by nondecreasing eigenvalues, with
$$M_M^{i,j,k}=M_N^{i,j,k}\qquad\text{for all }i,j,k.$$
\end{theorem}

\begin{remark}
\label{rmk}
Theorem~\ref{thm-2} is the matrix form of Theorem~\ref{thm}. Given such bases, the map $U\psi_i=\eta_i$ is a spectral identification, and
$$M^{i,j,k}=\Phi(\psi_i,\psi_j,\bar\psi_k).$$
Conversely, any spectral identification that intertwines $\Phi$ becomes Theorem~\ref{thm-2} after choosing orthonormal bases of each eigenspace and transporting them by $U$. The residual freedom in a spectral identification is $\prod_n\mathrm{U}(m_n)$; intertwining $\Phi$ is the condition that cuts that product down to an isometry of $(M,g,V)$ with $(N,h,W)$.
\end{remark}

Let $(M,g)$ be complete and connected, and let $\alpha\in C^\infty(M)$ be confining in the Bakry–Émery sense, so that the Witten operator
$$L_\alpha u=-\Delta_g u+\langle\nabla\alpha,\nabla u\rangle$$
is essentially self-adjoint and bounded below on $C_c^\infty(M)$, with
$$\sigma(L_\alpha)=\sigma_{\mathrm{disc}}(L_\alpha)=\{\nu_0=0<\nu_1\le\nu_2\le\cdots\}\to+\infty$$
in the weighted space $L^2(M,e^{-\alpha}\,d\mathrm{vol}_g)$. Write
$$\mathcal{A}_\alpha:=\bigoplus_{n=0}^\infty\ker(L_\alpha-\nu_n)\subset L^2(M,e^{-\alpha}\,d\mathrm{vol}_g)\cap C^\infty(M).$$
The same data $(N,h,\beta)$ produce $L_\beta$ and $\mathcal{A}_\beta$.
The invariant is the weighted triple form
$$\Phi_\alpha:\mathcal{A}_\alpha\times\mathcal{A}_\alpha\times\mathcal{A}_\alpha\to\mathbb{C},\qquad
\Phi_\alpha(u,v,w)=\int_M u\,v\,w\,e^{-\alpha}\,d\mathrm{vol}_g.$$
A linear map $U:\mathcal{A}_\alpha\to\mathcal{A}_\beta$ is a spectral identification if it is unitary for the weighted $L^2$ inner products and
$$U\bigl(\ker(L_\alpha-\nu_n)\bigr)=\ker(L_\beta-\nu_n)\qquad\text{for every }n.$$

\begin{corollary}
\label{coro}
Let $(M,g,\alpha)$ and $(N,h,\beta)$ be as above, and assume $L_\alpha$ and $L_\beta$ are isospectral. If there exists a spectral identification $U:\mathcal{A}_\alpha\to\mathcal{A}_\beta$ such that
$$\Phi_\beta(Uu,Uv,Uw)=\Phi_\alpha(u,v,w)\qquad\text{for all }u,v,w\in\mathcal{A}_\alpha,$$
then there is a diffeomorphism $F:N\to M$ with
$$F^*g=h\qquad\text{and}\qquad\beta=\alpha\circ F+c$$
for a constant $c\in\mathbb{R}$. In particular the weighted manifolds $(M,g,e^{-\alpha}\mathrm{vol}_g)$ and $(N,h,e^{-\beta}\mathrm{vol}_h)$ are isometric up to that constant rescaling of the weight.
\end{corollary}
In basis coordinates, we again have
\begin{corollary}
\label{coro-2}
The same conclusion holds if there exist weighted-orthonormal eigenbases $\{f_i\}$ of $L_\alpha$ and $\{g_i\}$ of $L_\beta$, ordered by nondecreasing eigenvalues, with
$$W^{i,j,k}:=\int_M f_i f_j\overline{f_k}\,e^{-\alpha}\,d\mathrm{vol}_g
=\int_N g_i g_j\overline{g_k}\,e^{-\beta}\,d\mathrm{vol}_h
\qquad\text{for all }i,j,k.$$
\end{corollary}

\begin{remark}
The Witten Laplacian on $p$-forms is the Hodge Laplacian of the weighted manifold plus $t\operatorname{Hess}\alpha\#_p+t^2\lvert\nabla\alpha\rvert^2$. Once $(M,g,\alpha)$ is reconstructed from the scalar array $W^{i,j,k}$, the operators $L_{\alpha}^{(p)}$ are determined, so their spectra and eigenform pairings against scalar eigenfunctions are invariants, not additional moduli.
\end{remark}
\section{Preliminaries}
\label{sec:pre}
Elements of $\mathcal{A}_M$ are finite sums $\sum\hat\phi(i)\psi_i$; they are dense in $L^2$ and lie in $C^\infty\cap C_0$.
Pointwise multiplication is
$$\phi\chi=\sum_k\Bigl(\sum_{i,j}\hat\phi(i)\hat\chi(j)M^{i,j,k}\Bigr)\psi_k.$$
Thus the structure constants determine the product of any two finite eigenfunction expansions. The same identity holds on $N$.

\section{Proof of Schr\"odinger Theorems}
\begin{proof}
Let $U:\mathcal{A}_M\to\mathcal{A}_N$ be a spectral identification intertwining $\Phi$, and write $\psi_i\mapsto\eta_i:=U\psi_i$ for $L^2$-orthonormal eigenbases ordered by nondecreasing eigenvalues. Matching triple products make $U$ an algebra homomorphism for pointwise multiplication on $\mathcal{A}_M=\operatorname{span}\{\psi_i\}$:
$$\psi_i\psi_j=\sum_k M^{i,j,k}\psi_k,\qquad
U(\phi\chi)=U(\phi)U(\chi).$$
(The constant function is a multiple of $\psi_0$ only if $V$ is constant; $U$ need not send $1$ to $1$.) Every element of $\mathcal{A}_M$ lies in $C^\infty\cap C_0$.
Finite spectral projectors of $H_M$ send $C_c^\infty(M)$ into $\mathcal{A}_M$ and converge in $C^\infty_{\mathrm{loc}}$. Thus $\mathcal{A}_M$ is dense in $C^1$ near any $p\in M$. If $\operatorname{span}\{\nabla\psi_i(p):i\ge 0\}\ne T_pM$, some $0\neq v\in T_pM$ would annihilate every $d\psi_i$, hence every $d\phi$ for $\phi\in\mathcal{A}_M$, and a $C^1$-limit would annihilate every $u\in C_c^\infty$, which is absurd. So some $d$-tuple satisfies
$$\det\bigl(d\psi_{i_a}\otimes d\psi_{i_b}(p)\bigr)\ne 0.$$
The joint evaluation
$$\mathrm{Ev}_M:M\to\mathbb{R}^{\mathbb{N}},\qquad p\mapsto\bigl(\psi_n(p)\bigr)_{n\ge 0}$$
is therefore an immersion. It is injective because $\mathcal{A}_M$ separates points (the same $C^0_{\mathrm{loc}}$ density, and $\psi_0>0$). So $\mathrm{Ev}_M$ is an embedding onto its image. The same holds for $\mathrm{Ev}_N$ and $\mathcal{A}_N$.

Define $F:N\to M$ by $\mathrm{Ev}_M\circ F=\mathrm{Ev}_N$ after the reindexing $\psi_n\mapsto\eta_n$, i.e.
$$\psi_n\circ F=\eta_n=U\psi_n\qquad\text{for all }n.$$
This is well-defined because $U$ preserves products and both evaluation maps are embeddings. Near any point the $d$-tuple above is a $C^\infty$ chart $x=(\psi_{i_1},\dots,\psi_{i_d})$. The same indices work on $N$ because $U$ preserves the spanning of $T^*$ (the Gram determinant is read from first derivatives of eigenfunctions, which match under composition). The matching chart is $y=(U\psi_{i_1},\dots,U\psi_{i_d})$, and $U\psi=\psi\circ F$ says $y=x\circ F$. Thus $F$ is the identity of $\mathbb{R}^d$ in these charts, hence a $C^\infty$ diffeomorphism.
Metric and potential. By construction
$$H_N(\psi\circ F)=(H_M\psi)\circ F,\qquad\psi\in\mathcal{A}_M.$$
Both operators are second-order scalar differential operators. The identity holds on a family whose differentials span $T^*$ at every point, so the principal symbols match:
$$F^*g=h.$$
The order-zero terms then give $V\circ F=W$.
This is Theorem 1. Theorem 2 is the same statement in an eigenbasis: $U\psi_i=\eta_i$ and matching $M^{i,j,k}$ are the coordinates of a spectral identification that intertwines $\Phi$, as in Remark 3.
\end{proof}

\subsection{Proof of Witten Corollaries}
\begin{proof}
The same embedding and chart construction, applied to a weighted-orthonormal eigenbasis $\{f_i\}$ of $L_\alpha$ and $\{g_i\}$ of $L_\beta$, produces a diffeomorphism $F$ with $f_n\circ F=g_n$. Then $L_\beta(u\circ F)=(L_\alpha u)\circ F$ on $\mathcal{A}_\alpha$. Principal symbols give $F^*g=h$; the first-order terms are the drifts, so $d\beta=F^*d\alpha$ and $\beta=\alpha\circ F+c$. This is Corollary~\ref{coro-2}. Corollary~\ref{coro} is the same statement for an abstract spectral identification $U$.
\end{proof}

\section{Example}
On $M=\mathbb{R}$ with the Euclidean metric, take
$$H=-\frac{d^2}{dx^2}+x^2.$$
The potential $V(x)=x^2$ is smooth, bounded below, and $V(x)\to+\infty$ as $|x|\to\infty$. Hence $\sigma_{\mathrm{ess}}(H)=\emptyset$. The spectrum is
$$\lambda_n=2n+1,\qquad n=0,1,2,\dots$$
(each of multiplicity one). The corresponding $L^2(\mathbb{R})$-normalized eigenfunctions are the Hermite functions
$$\psi_n(x)=\bigl(2^n n!\,\sqrt{\pi}\bigr)^{-1/2}H_n(x)\,e^{-x^2/2},$$
where $H_n$ are the physicist’s Hermite polynomials. They form an orthonormal basis of $L^2(\mathbb{R})$, lie in the Schwartz class $\mathcal{S}(\mathbb{R})\subset C_0(\mathbb{R})$, and satisfy the Agmon decay that makes every pointwise product $\psi_i\psi_j$ square-integrable.
\subsection{Triple Products}
Because the eigenfunctions are real,
$$M^{i,j,k}=\langle\psi_i\psi_j,\psi_k\rangle=\int_{-\infty}^{\infty}\psi_i(x)\psi_j(x)\psi_k(x)\,dx.$$
These integrals vanish unless $i+j+k$ is even (parity) and the three indices satisfy a triangle-type constraint coming from the linearization of Hermite polynomials. The linearization formula
$$H_n(x)H_m(x)=\sum_{r=0}^{\min(n,m)}\binom{n}{r}\binom{m}{r}r!\,2^r\,H_{n+m-2r}(x)$$
together with the Gaussian weight converts, after normalizing, into an explicit formula for $M^{i,j,k}$. Equivalently, the generating-function identity
$$\int_{-\infty}^{\infty}e^{-x^2}H_a(x)H_b(x)H_c(x)\,dx
=\sqrt{\pi}\,2^N\frac{a!\,b!\,c!}{(N-a)!(N-b)!(N-c)!}$$
(when $a+b+c=2N$ is even and each factorial in the denominator is defined and non-negative, and $0$ otherwise) yields $M^{i,j,k}$ after inserting the normalization constants of the $\psi_n$. In particular:

$M^{n,n,0}=\int\psi_n^2\psi_0\,dx>0$ (the ground state $\psi_0=\pi^{-1/4}e^{-x^2/2}$ is a strictly positive Gaussian);
the map $\psi_i\psi_j=\sum_k M^{i,j,k}\psi_k$ is the exact multiplication rule in the Hermite basis.

So the structure constants of pointwise multiplication on the dense subspace $\mathrm{span}\{\psi_n\}\subset C_0(\mathbb{R})$ are known in closed form.
\subsection{What the Theorem Says}
Suppose $(\mathbb{R},g,W)$ is another complete Riemannian line (so $g=e^{2\phi(x)}\,dx^2$ in some coordinate) with a smooth confining potential $W$, and suppose its Schrödinger operator $-\Delta_g+W$ is isospectral to $H$ and admits an eigenbasis $\{f_n\}$ with the same triple products
$$\langle f_i f_j,f_k\rangle=M^{i,j,k}.$$
The discrete-spectrum argument then produces a diffeomorphism $F:\mathbb{R}\to\mathbb{R}$ such that
$$F^*g=dx^2,\qquad W\circ F=x^2.$$

Because every eigenspace is one-dimensional, the singular-value packaging collapses to the absolute values $|M^{i,j,k}|$ together with a consistent choice of signs (the “diagonal litmus” of the compact paper: the products $M^{i,i,k}$ determine the even part of the algebra and fix most signs).

\subsection{Explicit Formula}
$$M^{i,j,k}=\langle\psi_i\psi_j,\psi_k\rangle
=\int_{\mathbb{R}}\psi_i(x)\psi_j(x)\psi_k(x)\,dx
=N_i N_j N_k\int_{\mathbb{R}}H_i(x)H_j(x)H_k(x)\,e^{-3x^2/2}\,dx,$$
where $N_n=(2^n n!\sqrt{\pi})^{-1/2}$.

$M^{i,j,k}=0$ unless both of the following hold -- parity: $i+j+k$ is even; triangle: $|i-j|\le k\le i+j$ (and cyclic permutations).

These are the oscillator analogues of the Clebsch–Gordan support conditions.

Change variables $x=\sqrt{2/3}\,y$. Then
$$\int_{\mathbb{R}}H_i(x)H_j(x)H_k(x)\,e^{-3x^2/2}\,dx
=\sqrt{\frac{2}{3}}\int_{\mathbb{R}}H_i\Bigl(\sqrt{\tfrac{2}{3}}\,y\Bigr)
H_j\Bigl(\sqrt{\tfrac{2}{3}}\,y\Bigr)
H_k\Bigl(\sqrt{\tfrac{2}{3}}\,y\Bigr)\,e^{-y^2}\,dy.$$
Each scaled polynomial expands by the finite identity
$$H_n(\gamma y)=\sum_{\ell=0}^{\lfloor n/2\rfloor}\gamma^{n-2\ell}(\gamma^2-1)^\ell\binom{n}{2\ell}\frac{(2\ell)!}{\ell!}\,H_{n-2\ell}(y),$$
with $\gamma=\sqrt{2/3}$. The product of the three expansions is a finite linear combination of products $H_a H_b H_c$. Titchmarsh’s formula \cite{T48} then evaluates every remaining integral:
$$\int_{\mathbb{R}}H_a H_b H_c\,e^{-y^2}\,dy
=
\begin{cases}
\dfrac{\sqrt{\pi}\,2^{s}\,a!\,b!\,c!}{(s-a)!(s-b)!(s-c)!}
& \text{if }a+b+c=2s\text{ is even and }s\ge a,b,c,\\
0 & \text{otherwise.}
\end{cases}$$
The result is a finite triple sum (at most $O(ijk)$ terms, typically far fewer). Combining the prefactors $N_i N_j N_k\sqrt{2/3}$ gives $M^{i,j,k}$ exactly.

Equivalently, the product of two normalized functions expands in a scaled Hermite basis
$$\psi_i(x)\psi_j(x)=\sum_{r=0}^{\lfloor(i+j)/2\rfloor}c_{r;ij}\,\psi_{i+j-2r}(\sqrt{2}\,x),$$
with explicit coefficients
$$c_{r;ij}
=\frac{(-1)^r}{\sqrt{2^{i+j-2r+1}\pi}}
\sqrt{\frac{(i+j-2r)!}{i!\,j!}}
\binom{i}{r}\binom{j}{r}r!\,2^{r}$$
(up to the conventional placement of the $\sqrt{2}$ in the argument; cf. \cite{K16}). Then
$$M^{i,j,k}=\sum_{r}c_{r;ij}\int_{\mathbb{R}}\psi_{i+j-2r}(\sqrt{2}\,x)\,\psi_k(x)\,dx,$$
and each scaled overlap is a ${}_2F_1$ (or terminates as a short hypergeometric sum).

With $f_n=\psi_n/\psi_0$ and $d\mu=\psi_0^2\,dx$,
$$W^{i,j,k}=\int_{\mathbb{R}}\frac{\psi_i\psi_j\psi_k}{\psi_0}\,dx
=\frac{N_i N_j N_k}{N_0}\int H_i H_j H_k\,e^{-x^2}\,dx.$$
Titchmarsh \cite{T48} then collapses to
$$W^{i,j,k}
=
\frac{\sqrt{i!\,j!\,k!}}{(s-i)!(s-j)!(s-k)!}
\quad\text{when }i+j+k=2s\text{ and }s\ge i,j,k,$$
and $0$ otherwise. In particular $W^{0,n,n}=1$, which is orthonormality of $\{\psi_n\}$ in $L^2(dx)$.

As these structure constants are non-negative on a multiplicity-1 spectrum, they are the associated singular-value invariants \cite{JS24} for $L$.

