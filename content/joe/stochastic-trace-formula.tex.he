\textit שלי{1997 Ph.D. תזה} כרשומה בבלוג.

\חלק{קיימת רק מדד Wiener n-ממדי אחד}

\section{Piecewise קירובים לינאריים לתנועה בראונית}

\חלק{מפת הפיתוח DM}

\סעיף{נוסחת קמרון-מרטין}

ליבות חום - Radon-Nicodym Deratives of Weiner Measure

\חלק{Notation}

$M$ הוא סעפת רימאנית סגורה עם מדד $g$, חיבור מדד $\nabla$, ומפעיל Laplace-Beltrami $\Delta_M$ (לא שלילי).  תן ל-$k_{-t\Delta/2}(x,y)$ לייצג את גרעין החום ב-$M$.

לכן $k_{-t\Delta/2}(x,x) = dDM_*\mu/\sqrt{g}dx$ הוא נגזרת ה-Radon-Nicodym של מדד ה-Wiener n-dimensional $\mu$, המוגבלת למשיכה לאחור של שטח לולאה רציף $\Omega_t(M)\vert_x$, דרך ההופכי של מפת הפיתוח המשמרת על-ידי Weiner $DM$. *הערה:* $DM^{-1}\Omega_t\vert_x$ אינו שטח לולאה.

$\Omega_t^0$ הוא השטח של לולאות חוזיות רציפות ב-$M$.

$\Omega_t[\gamma]$ הוא השטח של לולאות רציפות על $M$ homotopic לגיאודזיה הסגורה $\gamma$. תן ל-$\gamma_0$ להיות הלולאה הפרימיטיבית שלו.

$DM^{-1}\Omega_t^0[\gamma]$ היא הקדם-תמונה של לולאות חוזיות רציפות ב-$M$ שנכתבו כהיסטים הומוטופיים ל-$\gamma(s) = DM(\frac{s\ell(\gamma)}{t}\vec{e}^1), 0\leq s \leq t$. חישבו על קואורדינטות אופקיות – כל סיב הוא הגבול הגיאומטרי של הספירות הגיאודזיות התקופתיות $S_{\gamma_0(s)}^{n-1}(k\ell(\gamma_0)), 0\leq s \leq t, k\rightarrow\infty$, וקטורי בחבילה הרגילה מעל $\gamma_0$. אילוצי העקמומיות שלנו מרמזים על קואורדינטות אופקיות עבור כל $\gamma_0$ קיימים כמפת קואורדינטות חלקה, תואמת $DM$ עבור $\Omega_t^0[\gamma]$.

עכשיו $\vec{x}(\tau)+\ell(\gamma)\vec{e}^1$ היא נקודת הקצה \textit{undeveloped} של ה"offset" \textit{kinked geodesic} homotopic ל-$\gamma: DM(\vec{x}(\tau) + \frac{s\ell(\gamma)}{t}\vec{e}^1), 0\leq s \leq t$. העקומה היא תקופתית עם נקודה $\ell(\gamma_0)$, והיא מחדשת את נקודת ההתחלה שלה $DM(\vec{x}(\tau))$ בזמן $t$, מה שהופך את החישוב של הנגזרת קדימה שלה $J=\lim_{s\uparrow t}DM^\prime\vert_{DM(\vec{x}(\tau) + \frac{\ell(\gamma)s}{t}\vec{e}^1)}$ סחירה כאוטומורפיזם לינארי של $T_{DM(\vec{x}(\tau))}M$. חשוב לציין, ניתן לבנות את $J_{DM(\vec{x}(\tau)+\ell(\gamma)\vec{e}^1)}$ באמצעות \textbf{Jacobi Fields}, מכיוון ש-$DM$ \textbf{is} המפה האקספוננציאלית (מחודשת) לאורך כל סדרה של קווים ישרים מחוברים ב-$\mathbb{R}^n$. נלמד 1/2 $ \int_0^t \bra{dX}\ket{dX}_s$, עם הפתרון

\begin{equation}
\התחל{aligned}
X_t &amp;= X_0 + \int_0^t \sqrt{J}_{X_t} dB_t  \\
\end{aligned}
\end{equation}

$Z_{-\Delta/2}(t) := \int_M k_{-t\Delta/2}(x,x) \sqrt{g}dx = \sum_{j=0}^\infty e^{-\lambda_i t/2}$ הוא העקיבה של גרעין החום.

לבסוף, הבה נגדיר את הדברים הבאים מתוך נגזרותיהם של ראדון-ניקודים:

\begin{equation}
\התחל{aligned}
DM_*\mu(\Omega_t) &amp;:= \int_M DM_*\mu(\Omega_t\vert_x \sqrt{g}dx)\\
DM_*\mu(\Omega^0_t) &amp;:= \int_M DM_*\mu(\Omega^0_t\vert_x \sqrt{g}dx)\\
DM_*\mu(\Omega_t[\gamma]) &amp;:= \int_M DM_*\mu(\Omega_t[\gamma]\vert_x \sqrt{g}dx) \\
\end{aligned}
\end{equation}

\חלק{נוסחת מעקב פלסטיק}

\begin{equation}
\התחל{aligned}
Z_{-\Delta/2}(t) = DM_*\mu(\Omega_t) &amp;= DM_*\mu(\אומגה^0_t) + \sum_{\set{\gamma}} DM_*\mu(\Omega_t[\gamma]) \\
DM_*\mu(\Omega_t^0) &amp;\approx_{t\rightarrow 0} (2\pi t)^{-n/2}(vol(M) + t/6\int_M K(x)\sqrt{g} dx + O(t^2))\space \small\text{by McKean-Singer}\\\
DM_*\mu(\Omega_t[\gamma]) &amp;= e^{-\ell(\gamma)^2/2t}\int_M DM_*\mu(e^{\bra{J_BB_t}\ket{B_t}} _t \Omega_t^0[\gamma]\vert_x\sqrt{g}dx)\space\small \text{ מאת קמרון-מרטין}\\\
&amp;= e^{-\ell(\gamma)^2/2t}\int_{T_{\gamma_0}M} E(e^{J_B}_{t} | \Omega_t^0[\gamma]\vert_{x(\tau)})dx^1(\tau)\dots dx^n(\tau) d\tau\\\
\frac{dDM_*\mu(e^{-\ell(\gamma)x^1(t)}\Omega^0_t[\gamma])}{dx^1(\tau)\dots dx^n(\tau)d\tau}\vert_{\vec{y(\tau)}}&amp;\approx_{t\rightarrow 0} \frac{e^{-\bra{|I-J_{DM(\vec{x}(\tau),\vec{y}(\tau))}\vec{x}(\tau)}\ket{\vec{x}(\tau)}/2t}{(2 \pi t)^{(n+1)/2}}(1+O(t^2))\טקסט קטן{ גבול חצי קלאסי}\\\\\\\
\text{קואורדינטות הורוציקליות}: z(\tau) - x(\tau) &amp;= x + \ell(\gamma)\vec{e}^1\implies\\
\int_{M/S^1\oplus S^1}k_t(x,z) dx &amp;=\lim_{j\rightarrow\infty}\frac{e^{-\ell(\gamma)^2/2t}}{\sqrt{2\pi t}}E(e^{\bra{J_{X^j_t}\vec{x}}\ket{\vec{x}}})\\\
&amp;=\lim_{j\rightarrow\infty}\frac{e^{-\ell(\gamma)^2/2t}}{\sqrt{2\pi t}}\int_{M^j/S^1\oplus S^1}\frac{1}{\sqrt{2\pi t}^{jn}\det|I-J_{X^j}|}e^{-\ell(X^j)^2/2t}X^{j}\\
\end{aligned}
\end{equation}

\חלק{קירוב ונוסחת המעקב של סלברג}

ב $\dim = 2$ עקמומיות קבועה $-\kappa^2$ משטח במקרה,

\begin{equation}
\התחל{aligned}
\sqrt{J_{\vec{x}, \vec{y}}dRB&amp;=
\begin{pmatrix}
e^{\kappa d(\vec{x},\vec{y})/2} &amp;&amp;0\\\
0 &amp;&amp; e^{-\kappa d(\vec{x},\vec{y})/2}\\
\end{pmatrix}
\פשוטים&amp;\\\
\bra{\sqrt{J}dRB}\ket{\sqrt{J}dRB} &amp;= e^{\kappa \ell(B)}dRB_1^2 - e^{-\kappa \ell(B)}dRB_2^2\\
\int_0^t \bra{\sqrt{ J}dB}\ket{\sqrt{ J}dB} &amp;= e^{\kappa\ell(\gamma)} - e^{-\kappa\ell(\gamma)}\\\
\det I-J_{\gamma} &amp;= (e^{\kappa\ell(\gamma)/2}- e^{-\kappa\ell(\gamma)/2})^2
\end{aligned}
\end{equation}

קבוע מעל $(\vec{x},\tau)$, לכן שורת הקירוב $\approx_{t\rightarrow 0}$ במשוואה (2) הופכת ל-\textit{exact}:

\begin{equation}
\התחל{aligned}
DM_*\mu(\Omega_t[\gamma]) &amp;= \frac{e^{-\ell(\gamma)^2/2t}\ell(\gamma_0)}{\sqrt{2 \pi t}(e^{\kappa\ell(\gamma)/2} -e^{-\kappa\ell(\gamma)/2})}\\\
\gamma(t) = \gamma_0(kt)\פשוטים \\
&amp;=\frac{e^{-k^2\ell(\gamma_0)^2/2t}\ell(\gamma_0)}{2\sqrt{2\pi t}\sinh k\kappa\ell(\gamma_0)/2}\\\
\end{aligned}
\end{equation}

במקרה של תמרון היפרבולי $\dim=3$, אנו משתמשים בקואורדינטות מורכבות $(z,\bar{z})$ בחבילה הרגילה כדי לכתוב

\begin{equation}
\התחל{aligned}
J_{DM(\vec{x}+(\tau+\ell(\gamma))\vec{e}^1)} &amp;=
\begin{pmatrix}
e^{\kappa\ell(\gamma)} &amp;&amp; 0 &amp;&amp; 0\\
0 &amp;&amp; e^{-\kappa\ell(\gamma)+i\theta(\gamma)} &amp;&amp; 0 \\
0 &amp;&amp; 0 &amp;&amp; e^{-\kappa\ell(\gamma)-i\theta(\gamma)} \\
\end{pmatrix}\\
\פשוטים&amp; \\
\det I-{\perp_{\gamma_0}}^k &amp;= |1-e^{-k(\kappa\ell(\gamma_0)-i\theta(\gamma_0))}|^2
\end{aligned}
\end{equation}
ומאחר ש-$z=x^2+ix^3 \implies d\bar{z}\wedge dz= (dx^2-idx^3)\wedge(dx^2+idx^3) = 2idx^2\wedge dx^3$, הקירוב במשוואה (2) שוב הופך להיות מדויק:

\begin{equation}
\התחל{aligned}
\kappa &amp;= 1 \פשוטים \\
DM_*\mu(\Omega_t[\gamma])
&amp;=\frac{e^{-k^2\ell(\gamma_0)^2/2t}\ell(\gamma_0)}{2\sqrt{2\pi t (1-e^{-k\ell(\gamma_0)})}|e^{k\ell(\gamma_0)/2}-e^{-k(\ell(\gamma_0)/2-i\theta(\gamma_0)))}|}\\
\end{aligned}
\end{equation}

