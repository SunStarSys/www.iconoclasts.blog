\section{Les noyaux de chaleur comme dérivés du radon-nicodyme de Weiner Measure}

\section{Notation}

$M$ est un collecteur riemannien fermé $\dim=n$ avec métrique $g$, connexion métrique $\nabla$ et opérateur Laplace-Beltrami (non négatif) $\Delta_M$.  Laissez $k_{-t\Delta/2}(x,y)$ représenter le noyau de chaleur sur $M$.

Par conséquent, $k_{-t\Delta/2}(x,x) = dDM_*\mu/\sqrt{g}dx$ est la dérivée Radon-Nicodym de la mesure de Wiener n-dimensionnelle $\mu$, limitée au retrait de l'espace de boucle continue $\Omega_t(M)\vert_x$, via l'inverse de la carte de développement de conservation de mesure Weiner $DM$. *Remarque :* $DM^{-1}\Omega_t\vert_x$ n'est pas un espace de boucle.

$\Omega_t^0$ est l'espace des boucles contractibles continues sur $M$.

$\Omega_t[\gamma]$ est l'espace des boucles continues sur $M$ homotopique à la géodésique fermée $\gamma$. Soit $\gamma_0$ sa boucle primitive.

$DM^{-1}\Omega_t^0[\gamma]$ est la préimage des boucles contractibles continues sur $M$ écrites comme des décalages homotopiques à $\gamma(s) = DM(\frac{s\ell(\gamma)}{t}\vec{e}^1), 0\leq s \leq t$. Pensez aux coordonnées horocycliques : chaque fibre est la limite géométrique des sphères géodésiques périodiques $S_{\gamma_0(s)}^{n-1}(k\ell(\gamma_0)), 0\leq s \leq t, k\rightarrow\infty$, vectorisées dans le groupe normal au-dessus de $\gamma_0$. Nos contraintes de courbure impliquent que des coordonnées horocycliques pour chaque $\gamma_0$ existent comme une carte de coordonnées lisse et compatible avec $DM$ pour $\Omega_t^0[\gamma]$.

Maintenant $\vec{x}(\tau)+\ell(\gamma)\vec{e}^1$ est le point d'extrémité \textit{undeveloped} du "offset" \textit{kinked geodesic} homotopique à $\gamma : DM(\vec{x}(\tau) + \frac{s\ell(\gamma)}{t}\vec{e}^1), 0\leq s \leq t$. La courbe est périodique avec la période $\ell(\gamma_0)$, et elle revisite son point de départ kinked $DM(\vec{x}(\tau))$ au moment $t$, faisant le calcul de sa dérivée à terme $J=\lim_{s\uparrow t}DM^\prime\vert_{DM(\vec{x}(\tau) + \frac{\ell(\gamma)s}{t}\vec{e}^1)}$ tractible comme un automorphisme linéaire de $T_{DM(\vec{x}(\tau))}M$. Il est important de noter que $J_{DM(\vec{x}(\tau)+\ell(\gamma)\vec{e}^1)}$ peut être construit en utilisant \textbf{Jacobi Fields}, puisque $DM$ \textbf{est} la carte exponentielle (itérée) le long de toute série de lignes droites connectées dans $\mathbb{R}^n$. Nous étudierons $ 1/2 \int_0^t \bra{dX}\ket{dX}_s$, avec la solution

\début{équation}
\début{aligné}
X_t &amp;= X_0 + \int_0^t \sqrt{J}_{X_t} dB_t  \\
\end{aligned}
\end{equation}

$Z_{-\Delta/2}(t) := \int_M k_{-t\Delta/2}(x,x) \sqrt{g}dx = \sum_{j=0}^\infty e^{-\lambda_i t/2}$ est la trace du noyau Heat.

Définissons enfin ce qui suit à partir de leurs dérivés Radon-Nicodyme :

\début{équation}
\début{aligné}
DM_*\mu(\Omega_t) &amp; := \int_M DM_*\mu(\Omega_t\vert_x \sqrt{g}dx)\\
DM_*\mu(\Omega^0_t) &amp; := \int_M DM_*\mu(\Omega^0_t\vert_x \sqrt{g}dx)\\\
DM_*\mu(\Omega_t[\gamma]) &amp; := \int_M DM_*\mu(\Omega_t[\gamma]\vert_x \sqrt{g}dx) \\
\end{aligned}
\end{equation}

\section{Formule de trace stochastique}

\début{équation}
\début{aligné}
Z_{-\Delta/2}(t) = DM_*\mu(\Omega_t) &amp;= DM_*\mu(\Omega^0_t) + \sum_{\set{\gamma}} DM_*\mu(\Omega_t[\gamma]) \\
DM_*\mu(\Omega_t^0) &amp;\approx_{t\rightarrow 0} (2\pi t)^{-n/2}(vol(M) + t/6\int_M K(x)\sqrt{g} dx + O(t^2))\space \small\text{by McKean-Singer}\\\
DM_*\mu(\Omega_t[\gamma]) &amp;= e^{-\ell(\gamma)^2/2t}\int_M DM_*\mu(e^{\bra{J_BB_t}\ket{B_t}} _t \Omega_t^0[\gamma]\vert_x\sqrt{g}dx)\space\small \text{ by Cameron-Martin}\\
&amp;= e^{-\ell(\gamma)^2/2t}\int_{T_{\gamma_0}M} E(e^{J_B}_{t} | \Omega_t^0[\gamma]\vert_{x(\tau)})dx^1(\tau)\dots dx^n(\tau) d\tau\\
\frac{dDM_*\mu(e^{-\ell(\gamma)x^1(t)}\Omega^0_t[\gamma])}{dx^1(\tau)\dots dx^n(\tau)d\tau}\vert_{\vec{y(\tau)}}&amp;\approx_{t\rightarrow 0} \frac{e^{-\bra{|I-J_{DM(\vec{x}(\tau),\vec{y}(\tau))}\vec{x}(\tau)}\ket{\vec{x}(\tau)}/2t}}{(2 \pi t)^{(n+1)/2}}(1+O(t^2))\petit \texte{ limite semi-classique}\\\\
\text{Coordonnées horocycliques} : z(\tau) - x(\tau) &amp;= x + \ell(\gamma)\vec{e}^1\implies\\
\int_{M/S^1\oplus S^1}k_t(x,z) dx &amp;=\lim_{j\rightarrow\infty}\frac{e^{-\ell(\gamma)^2/2t}}{\sqrt{2\pi t}}E(e^{\bra{J_{X^j_t}\vec{x}}\ket{\vec{x}}})\\
&amp;=\lim_{j\rightarrow\infty}\frac{e^{-\ell(\gamma)^2/2t}}{\sqrt{2\pi t}}\int_{M^j/S^1\oplus S^1}\frac{1}{\sqrt{2\pi t}^{jn}\det|I-J_{X^j}|}e^{-\ell(X^j)^2/2t}X^{j}\\
\end{aligned}
\end{equation}

\section{Approximation et formule de trace de Selberg}

Dans le cas de surface $\dim = 2$ courbure constante $-\kappa^2$,

\début{équation}
\début{aligné}
\sqrt{J_{\vec{x}, \vec{y}}}dRB&amp;=
\commencer{pmatrix}
e^{\kappa d(\vec{x},\vec{y})/2} &amp;&amp; 0\\
0 &amp;&amp; e^{-\kappa d(\vec{x},\vec{y})/2}\\
\end{pmatrix}
\implique&amp;\\
\bra{\sqrt{J}dRB}\ket{\sqrt{J}dRB} &amp;= e^{\kappa \ell(B)}dRB_1^2 - e^{-\kappa \ell(B)}dRB_2^2\\
\int_0^t \bra{\sqrt{ J}dB}\ket{\sqrt{ J}dB} &amp;= e^{\kappa\ell(\gamma)} - e^{-\kappa\ell(\gamma)}\\
\det I-J_{\gamma} &amp;= (e^{\kappa\ell(\gamma)/2}- e^{-\kappa\ell(\gamma)/2})^2
\end{aligned}
\end{equation}

qui est constante sur $(\vec{x},\tau)$, de sorte que la ligne approximative $\approx_{t\rightarrow 0}$ dans l'équation (2) devient \textit{exact} :

\début{équation}
\début{aligné}
DM_*\mu(\Omega_t[\gamma]) &amp;= \frac{e^{-\ell(\gamma)^2/2t}\ell(\gamma_0)}{\sqrt{2 \pi t}(e^{\kappa\ell(\gamma)/2} -e^{-\kappa\ell(\gamma)/2})}\\
\gamma(t) = \gamma_0(kt)\implique \\
&amp;=\frac{e^{-k^2\ell(\gamma_0)^2/2t}\ell(\gamma_0)}{2\sqrt{2\pi t}\sinh k\kappa\ell(\gamma_0)/2}\\
\end{aligned}
\end{equation}

Dans le cas du manifeste hyperbolique $\dim=3$, nous utilisons des coordonnées complexes $(z,\bar{z})$ sur le paquet normal pour écrire

\début{équation}
\début{aligné}
J_{DM(\vec{x}+(\tau+\ell(\gamma))\vec{e}^1)} &amp;=
\commencer{pmatrix}
e^{\kappa\ell(\gamma)} &amp;&amp; 0 &amp;&amp; 0\\
0 &amp;&amp; e^{-\kappa\ell(\gamma)+i\theta(\gamma)} &amp;&amp; 0 \\
0 &amp;&amp; 0 &amp;&amp; e^{-\kappa\ell(\gamma)-i\theta(\gamma)} \\
\end{pmatrix}\\
\implique&amp; \\
\det I-{\perp_{\gamma_0}}^k &amp;= |1-e^{-k(\kappa\ell(\gamma_0)-i\theta(\gamma_0))}|^2
\end{aligned}
\end{equation}
et puisque $z=x^2+ix^3 \implique d\bar{z}\wedge dz= (dx^2-idx^3)\wedge(dx^2+idx^3) = 2idx^2\wedge dx^3$, l'approximation dans l'équation (2) redevient exacte :

\début{équation}
\début{aligné}
\kappa &amp;= 1 \implique \\
DM_*\mu(\Omega_t[\gamma])
&amp;=\frac{e^{-k^2\ell(\gamma_0)^2/2t}\ell(\gamma_0)}{2\sqrt{2\pi t (1-e^{-k\ell(\gamma_0)})}|e^{k\ell(\gamma_0)/2}-e^{-k(\ell(\gamma_0)/2-i\theta(\gamma_0))}|}\\
\end{aligned}
\end{equation}

