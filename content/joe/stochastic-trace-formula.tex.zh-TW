\section{ 只有一個 n 維度 Wiener 測量 }

\section{Piecewise Linear Approximated to Brownian Motion}

\ 區段 {Development Map DM}

\ 區段 {Cameron-Martin Formula}

\section{Heat Kernels as Radon-Nicodym Derivatives of Weiner Measure}

\section{Notation}

$M$ 是一個由 $\dim=n$ 封閉的 Riemannian manifold，使用度量 $g$、\nabla$ 和 (非負數) Laplace-Beltrami 運算子 $\Delta_M$。讓 $k_{-t\Delta/2} (x，y) $ 代表 $M$ 上的熱核心。

因此，$k_{-t\Delta/2} (x，x) = dDM_*\mu/\sqrt{g}dx$ 是 n 維度 Wiener 測量 $\mu$ 的 Radon-Nicodym 導函數，僅限於透過 Weiner 測量保留開發對應 $DM$ 的倒回連續迴圈空間 $\Omega_t (M) \vert_x$。* 備註：* $DM^{-1}\Omega_t\vert_x$ 不是迴圈空間。

$\Omega_t^0$ 是 $M$ 上連續可簽約迴圈的空間。

$\Omega_t[\gamma]$ 是 $M$ 同位素對封閉 geodesic $\gamma$ 的連續迴圈空間。讓 $\gamma_0$ 成為原始迴圈。

$DM^{-1}\Omega_t^0[\gamma]$ 是 $M$ 上以抵銷同位素形式寫入 $\gamma (s) = DM (\frac{s\ell (\gamma) }{t}\vec{e}^1)，0\leq s \leq t$ 的連續可約迴圈的前置影像。將多週期座標 (Horocyclic Coordinate) -- 每個光纖做為定期幾何圖形球體的幾何限制 $S_{\gamma_0 (s) }^{n-1} (k\ell (\gamma_0))，0\leq s \leq t，k\rightarrow\infty$，向量化為「一般組合 (Normal Bundle)」超過 $\gamma_0$。我們的曲率限制條件表示每 $\gamma_0$ 的 Horocyclic 座標是 $\Omega_t^0[\gamma]$ 的平滑 $DM$ 相容座標對應。

現在 $\vec{x} (\tau) +\ell (\gamma) \vec{e}^1$ 是 \textit{undeveloped} 端點 「偏移」\textit{kinked geodesic} 同位素至 $\gamma：DM (\vec{x} (\tau) + \frac{s\ell (\gamma) }{t}\vec{e}^1)，0\leq s \leq t$。曲線會定期以期間 $\ell (\gamma_0) $ 進行，且會在時間 $t$ 重新查看其閃爍的起點 $DM (\vec{x} (\tau)) $，以計算其正向導函數 $J=\lim_{s\uparrow t}DM^\prime\vert_{DM (\vec{x} (\tau) + \frac{\ell (\gamma) s}{t}\vec{e}^1) }$ 可作為 $T_{DM (\vec{x} (\tau)) }M$ 的線性自動形態。重要的是，$J_{DM (\vec{x} (\tau) +\ell (\gamma) \vec{e}^1) }$ 可以使用 \textbf{Jacobi Fields 建構，因為 $DM$ \textbf{is} 與 $\mathbb{R}^n$ 中任一串連的直線相連，此為 $J_{DM (\vec{x} (\tau) +\ell (\gamma) \vec{e}^1) }$。我們將研究 $1/2 \int_0^t \bra{dX}\ket{dX}_s$ 與解決方案

\begin{equation}
\ 開始 {aligned}
X_t &amp;= X_0 + \int_0^t \sqrt{J}_{X_t} dB_t  \\
\end{aligned}
\end{equation}

$Z_{-\Delta/2} (t)：= \int_M k_{-t\Delta/2} (x，x) \sqrt{g}dx = \sum_{j=0}^\infty e^{-\lambda_i t/2}$ 是熱力核心的追蹤。

最後讓我們從他們的 Radon-Nicodym 衍生工具中定義以下內容：

\begin{equation}
\ 開始 {aligned}
DM_*\mu (\Omega_t) &amp;:= \int_M DM_*\mu (\Omega_t\vert_x \sqrt{g}dx) \\
DM_*\mu (\Omega^0_t) &amp;:= \int_M DM_*\mu (\Omega^0_t\vert_x \sqrt{g}dx) \\\
DM_*\mu (\Omega_t[\gamma]) &amp;:= \int_M DM_*\mu (\Omega_t[\gamma]\vert_x \sqrt{g}dx) \\
\end{aligned}
\end{equation}

\ 區段 { 彈性追蹤公式 }

\begin{equation}
\ 開始 {aligned}
Z_{-\Delta/2} (t) = DM_*\mu (\Omega_t) &amp;= DM_*\mu (\Omega^0_t) + \sum_{\set{\gamma}} DM_*\mu (\Omega_t[\gamma]) \\
DM_*\mu (\Omega_t^0) &amp;\approx_{t\rightarrow 0} (2\pi t) ^{-n/2} (vol (M) + t/6\int_M K (x) \sqrt{g} dx + O (t^2)) \space \small\text{by McKean-Singer}\\
DM_*\mu (\Omega_t[\gamma]) &amp;= e^{-\ell (\gamma) ^2/2t}\int_M DM_*\mu (e^{\bra{J_BB_t}\ket{B_t}} _t \Omega_t^0[\gamma]\vert_x\sqrt{g}dx) \space\small \text{ by Cameron-Martin}\\
&amp;= e^{-\ell (\gamma) ^2/2t}\int_{T_{\gamma_0}M} E (e^{J_B}_{t} | \Omega_t^0[\gamma]\vert_{x (\tau) }) dx^1 (\tau) \dots dx^n (\tau) d\\
\frac{dDM_*\mu (e^{-\ell (\gamma) x^1 (t) }\Omega^0_t[\gamma]) }{dx^1 (\tau) \dots dx^n (\tau) d\tau}\vert_{\vec{y (\tau) }}&amp;\approx_{t\rightarrow 0} \frac{e^{-\bra{|I-J_{DM (\vec{x} (\tau) ,\vec{y} (\tau)) }\vec{x} (\tau) }\ket{\vec{x} (\tau) }/2t}}{ (2 \pi t) ^{ (n+1) /2}} (1+O (t^2)) \small \text{ semi-classical limit}\\\
\text{Horocyclic coordinate}: z (\tau) - x (\tau) &amp;= x + \ell (\gamma) \vec{e}^1\implies\\
\int_{M/S^1\oplus S^1}k_t (x,z) dx &amp;=\lim_{j\rightarrow\infty}\frac{e^{-\ell (\gamma) ^2/2t}}{\sqrt{2\pi t}}E (e^{\bra{J_{X^j_t}\vec{x}}\ket{\vec{x}}}) \\
&amp;=\lim_{j\rightarrow\infty}\frac{e^{-\ell (\gamma) ^2/2t}}{\sqrt{2\pi t}}\int_{M^j/S^1\oplus S^1}\frac{1}{\sqrt{2\pi t}^{jn}\det|I-J_{X^j}|}e^{-\ell (X^j) ^2/2t}X^{j}\\
\end{aligned}
\end{equation}

\section{Approximation 和 Selberg Trace Formula}

在 $\dim = 2$ 常數曲率 $-\kappa^2$ 表面大小，

\begin{equation}
\ 開始 {aligned}
\sqrt{J_{\vec{x}, \vec{y}}}dRB&amp;=
\ 開始 {pmatrix}
e^{\kappa d (\vec{x},\vec{y}) /2} &amp;&amp; 0\\
0&amp;&amp; e^{-\kappa d (\vec{x},\vec{y}) /2}\\
繁體中文 (台灣)
\implies&amp;\\
\bra{\sqrt{J}dRB}\ket{\sqrt{J}dRB} &amp;= e^{\kappa \ell (B) }dRB_1^2 - e^{-\kappa \ell (B) }dRB_2^2\\
int_0^t \bra{\sqrt{ J}dB}\ket{\sqrt{ J}dB} &amp;= e^{\kappa\ell (\gamma) } - e^{-\kappa\ell (\gamma) }\\
\det I-J_{\gamma} &amp;= (e^{\kappa\ell (\gamma) /2}- e^{-\kappa\ell (\gamma) /2}) ^2
\end{aligned}
\end{equation}

常數超過 $ (\vec{x}，\tau) $，因此「方程式 (2)」中的近似 $\approx_{t\rightarrow 0}$ 行變成 \textit{exact}：

\begin{equation}
\ 開始 {aligned}
DM_*\mu (\Omega_t[\gamma) &amp;= \frac{e^{-\ell (\gamma) ^2/2t}\ell (\gamma_0) }{\sqrt{2 \pi t} (e^{\kappa\ell (\gamma) /2} -e^{-\kappa\ell (\gamma) /2}) }\\
\gamma (t) = \gamma_0 (kt) \implies \\
&amp;=\frac{e^{-k^2\ell (\gamma_0) ^2/2t}\ell (\gamma_0) }{2\sqrt{2\pi t}\sinh k\kappa\ell (\gamma_0) /2}\\
\end{aligned}
\end{equation}

在 $\dim=3$ 雙曲折疊式摺疊式功能表中，我們使用一般組合的複雜座標 $ (z，\bar{z}) $ 來寫入

\begin{equation}
\ 開始 {aligned}
J_{DM (\vec{x}+ (\tau+\ell (\gamma)) \vec{e}^1) } &amp;=
\ 開始 {pmatrix}
e^{\kappa\ell (\gamma) } &amp;&amp; 0 &amp;&amp; 0\\
0&amp;&amp; e^{-\kappa\ell (\gamma) +i\theta (\gamma) } &amp;&amp; 0 \\
0 &amp;&amp; 0 &amp;&amp; e^{-\kappa\ell (\gamma) -i\theta (\gamma) } \\
\end{pmatrix}\
\implies&amp; \\
\det I-{\perp_{\gamma_0}}^k &amp;= |1-e^{-k (\kappa\ell (\gamma_0) -i\theta (\gamma_0)) }|^2
\end{aligned}
\end{equation}
且由於 $z=x^2+ix^3 \implies d\bar{z}\wedge dz= (dx^2-idx^3) \wedge (dx^2+idx^3) = 2idx^2\wedge dx^3$，因此 Equation (2) 中的近似值會再次變成精確值：

\begin{equation}
\ 開始 {aligned}
\kappa &amp;= 1 個 \implies \\
DM_*\mu (\Omega_t[\gamma)
&amp;=\frac{e^{-k^2\ell (\gamma_0) ^2/2t}\ell (\gamma_0) }{2\sqrt{2\pi t (1-e^{-k\ell (\gamma_0) }) }|e^{k\ell (\gamma_0) /2}-e^{-k (\gamma_0) /2-i\theta (\gamma_0)) }|}\\
\end{aligned}
\end{equation}

