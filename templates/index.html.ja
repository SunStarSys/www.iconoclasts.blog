{% if bibliography %}
{% filter markdown %}

## 参照

{% for b in bibliography.content|dictsort:"author" %}
{% ifequal b.type "article" %}
1. <a id="{{b.id|utf8decode}}"> [{{b.id|utf8decode}}] {{b.author|utf8decode|cuts:"\\-"|safe}}</a>. "{{b.title|utf8decode|cuts:"\\-"|safe}}", {{b.journal|utf8decode|cuts:"\\-"|safe}} {{b.volume}}{% if b.number %}.{{b.number}}{% endif %} ({{b.year}}): {{b.pages}}{% if b.doi %}, `DOI`: <{{b.doi|utf8decode|cuts:"\\-"}}>{% endif %}.
{% endifequal %}
{% ifequal b.type "book" %}
1. <a id="{{b.id|utf8decode}}"> [{{b.id|utf8decode}}] {{b.author|utf8decode|cuts:"\\-"|safe}}</a>. {{b.title|utf8decode|cuts:"\\="|safe}}. {% if b.volume %}ボリューム{{b.volume}}. {% endif %}{% if b.number %}いいえ。{{b.number}}.{% endif %} {{b.publisher|utf8decode|cuts:"\\-"|safe}}, {{b.year}}.
{% endifequal %}
{% ifequal b.type "online" %}
1. <a id="{{b.id|utf8decode}}"> [{{b.id|utf8decode}}] {{b.author|utf8decode|cuts:"\\-"|safe}}</a>. "{{b.title|utf8decode|cuts:"\\-"|safe}}", {% if b.url %}`URL`: <{{b.url|utf8decode|cuts:"\\-"}}>{% endif %}{% if b.doi %} `DOI`: <{{b.doi|utf8decode|cuts:"\\-"}}>, {% endif %}{% if b.archivePrefix %}`{{b.archivePrefix}}`:{{b.eprint}}.{% endif %}
{% endifequal %}
{% ifequal b.type "proceedings" %}
1. <a id="{{b.id|utf8decode}}"> [{{b.id|utf8decode}}] {{b.author|utf8decode|cuts:"\\-"|safe}}</a>. "{{b.title|utf8decode|cuts:"\\-"|safe}}", {{b.journal|utf8decode|cuts:"\\-"|safe}} {{b.volume}}{% if b.number %}.{{b.number}}{% endif %} ({{b.year}}): {{b.pages}}{% if b.doi %}, `DOI`: <{{b.doi|utf8decode|cuts:"\\-"}}>{% endif %}.
{% endifequal %}
{% ifequal b.type "phdthesis" %}
1. <a id="{{b.id|utf8decode}}"> [{{b.id|utf8decode}}] {{b.author|utf8decode|cuts:"\\-"|safe}}</a>. "{{b.title|utf8decode|cuts:"\\-"|safe}}", {{b.school|utf8decode|cuts:"\\-"|safe}} ({{b.year}}).
{% endifequal %}
{% endfor %}

{% endfilter %}
{% endif %}

{% if permalink %}
<span class="badge bg-info" style="color:#000">固定リンク</span>&nbsp;
{% endif %}

{% if headers.published %}
<span class="badge bg-success text-white"><a style="color:#fff" href="{{headers.published|safe}}">公開済</a></span>&nbsp;
{% endif %}

{% if archive_path %}{% ifequal headers.status
"アーカイブ済"
%}
<span class="badge bg-warning">
  <a style="color:#000" href="{{archive_path}}">アーカイブ済み</a></span>&nbsp;
{% endifequal %}{% endif %}

{% for k in headers.keywords %}
<span class="badge bg-danger text-white">
  <a style="color:#fff" href="/dynamic/search{{path|dirname}}/?regex=%23{{k|urlencode}};lang={{lang}};markdown_search=1">#{{k}}</a>
</span>&nbsp;
{% endfor %}

<p>
  &nbsp;
</p>

{% for c in headers.categories %}
<button type="button" class="btn btn-success">
  <a style="color:#fff" href="{{category_root|default_if_none:".."}}/{{c|append:"/index.html"}}{{lang}}">{{c}}</a></button>
&nbsp;
{% endfor %}

<hr>
<div class="card border-warning">
	<form action="https://cms.sunstarsys.com/redirect" id="form" method="GET">
    <input type="hidden" id="action" name="action" value="comment">
    <input type="hidden" name="lang" value="{{lang|cut:"."}}">
    <div class="card-header">
      <h3 class="card-title">コメント{% if category_root %}{% if archive_root %} &nbsp;
        <button type="submit" name="uri" value="https://{{website}}{{path|dirname}}/{{path|basename:0|append:".page/comment.md"}}{{lang}}" class="btn btn-sm btn-outline-warning">
          新規
        </button>
{% endif %}{% endif %}
      </h3>
    </div>
    <!--#config errmsg="" -->
    <div id="comments" class="card-body">
      {% for c in comments %}
      {% if c.closed %}
      {% else %}
        <!--#include virtual="{{path|basename:0|append:".page/"}}{{c.key|append:".html"}}{{lang}}" -->
      {% endif %}
      {% endfor %}
    </div>
  </form>
</div>

<hr>
{% if category_root %}{% if archive_root %}
<div class="card border-dark">
  <div class="card-header">
    <h3 class="card-title">添付&nbsp;
    <button type="button" class="btn btn-sm btn-outline-dark"><a href="https://cms.sunstarsys.com/redirect?uri=https://{{website}}{{path|dirname}}/{{path|basename:0|append:".page/;action=add"}}">管理</a></button>
</h3>
  </div>
  <div class="card-body">
    <ul>
      {% for a in attachments %}
      <li><a href="{{a}}">{{a|basename:0}}</a></li>
      {% endfor %}
    </ul>
  </div>
  <div class="card-header">
    <h3 class="card-title">リンク&nbsp;
    <button type="button" class="btn btn-sm btn-outline-dark"><a href="https://cms.sunstarsys.com/redirect?uri=https://{{website}}{{path|dirname}}/{{path|basename:0|append:".page/links.md"}}{{lang|append:";action=add"}}">管理</a></button></h3>
  </div>
  <div class="card-body">
    {{ links.content|markdown }}
  </div>
</div>
{% endif %}{% endif %}

<script type="text/javascript">
  function thread_comments() {
      var html = "";
      var current_level = 0;
      var last_level = 0;
      for (const e of $("article").toArray()) {
          const id = e.getAttribute("id");
          current_level = (id.length - 15) / 2;
          if (current_level == last_level)
              html += "</li><li>" + e.outerHTML;
          else if (current_level == last_level + 1)
              html += "<ul><li>" + e.outerHTML;
          else if (current_level < last_level)
              html += (new Array(last_level - current_level + 1)).join("</li></ul>") + "<li>" + e.outerHTML;
          else
              continue;
          last_level = current_level;
      }
      html += (new Array(last_level + 1)).join("</li></ul>");
      $("#comments").html(html);
  }

function clear_invalid_href() {
      for (const e of $("article").find("a").toArray()) {
          const hr = e.getAttribute("href");
          if (hr && hr.length > 1 && hr.indexOf("#") == 0 && $(hr).length == 0)
              $(e).removeAttr("href");
      }
  }

thread_comments();
  clear_invalid_href();
</script>

{% if deps.0 %}
{% filter markdown %}
--------

## インデックス

<dl id="index">
{% for d in deps %}
<dt>

{{d.1.content|ssi|img|markdown|removetags:"script style"|removeattrs:"on\w+ style class"}}

</dt>
<dd>

- [{{d.1.headers.title|safe}}]({{d.0|urlencode}}) &mdash; {{d.1.content|ssi|lede|removetags:"script style"|removeattrs:"on\w+ style class"}} ... <small><em>{{d.1.content|ssi|vcs_date:lang|striptags}}</em></small>

--------

</dd>
{% endfor %}
</dl>
{% endfilter %}
{% endif %}
