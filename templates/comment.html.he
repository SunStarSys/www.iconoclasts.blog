      <article id="article-{{key}}" {% if muted %}class="text-muted"{% endif %}>
        <header>
          <h6 class="card-title" id="{{key}}">
            <a href="#{{key}}-link" class="reference-link">{{headers.title|removetags:"script style"|removeattrs:"on\w+ style class"}}</a>
            מאת {{content|vcs_author:lang|removetags:"script style"|removeattrs:"on\w+ style class"}}
            פעיל <em><time>{{content|vcs_date:lang|removetags:"script style"|removeattrs:"on\w+ style class"}}</time></em>
            {% if muted %}
            {% else %}
            {% if important %}
            &nbsp;
            <span class="badge bg-danger text-white">חשוב!</span>
            {% endif %}
            {% if category_root %}{% if archive_root %}
			  &nbsp;
            <button type="submit" class="btn btn-sm btn-outline-warning" name="uri"
                    value="https://{{website}}{{path|dirname}}/{{key}}.md{{lang}}">
              השב
            </button>
			{% endif %}{% endif %}
            {% endif %}
          </h6>
        </header>
        <small>
          <p class="card-text">{{content|markdown|removetags:"script style"|removeattrs:"on\w+ style class"}}</p>
          <hr>
          <p>&nbsp;</p>
        </small>
      </article>
