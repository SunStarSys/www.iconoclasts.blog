{% if bibliography %}
{% filter markdown %}

## 參考

{% for b in bibliography.content|dictsort:"author" %}
{% ifequal b.type "article" %}
1. <a id="{{b.id|utf8decode}}"> [{{b.id|utf8decode}}] {{b.author|utf8decode|cuts:"\\-"|safe}}</a>. "{{b.title|utf8decode|cuts:"\\-"|safe}}", {{b.journal|utf8decode|cuts:"\\-"|safe}} {{b.volume}}{% if b.number %}.{{b.number}}{% endif %} ({{b.year}}): {{b.pages}}{% if b.doi %}, `DOI`: <{{b.doi|utf8decode|cuts:"\\-"}}>{% endif %}.
{% endifequal %}
{% ifequal b.type "book" %}
1. <a id="{{b.id|utf8decode}}"> [{{b.id|utf8decode}}] {{b.author|utf8decode|cuts:"\\-"|safe}}</a>. {{b.title|utf8decode|cuts:"\\="|safe}}. {% if b.volume %} 博客{{b.volume}}. {% endif %}{% if b.number %} 編號{{b.number}}.{% endif %} {{b.publisher|utf8decode|cuts:"\\-"|safe}}, {{b.year}}.
{% endifequal %}
{% ifequal b.type "online" %}
1. <a id="{{b.id|utf8decode}}"> [{{b.id|utf8decode}}] {{b.author|utf8decode|cuts:"\\-"|safe}}</a>. "{{b.title|utf8decode|cuts:"\\-"|safe}}", {% if b.url %}`URL`: <{{b.url|utf8decode|cuts:"\\-"}}>{% endif %}{% if b.doi %} `DOI`: <{{b.doi|utf8decode|cuts:"\\-"}}>, {% endif %}{% if b.archivePrefix %}`{{b.archivePrefix}}`:{{b.eprint}}.{% endif %}
{% endifequal %}
{% ifequal b.type "proceedings" %}
1. <a id="{{b.id|utf8decode}}"> [{{b.id|utf8decode}}] {{b.author|utf8decode|cuts:"\\-"|safe}}</a>. "{{b.title|utf8decode|cuts:"\\-"|safe}}", {{b.journal|utf8decode|cuts:"\\-"|safe}} {{b.volume}}{% if b.number %}.{{b.number}}{% endif %} ({{b.year}}): {{b.pages}}{% if b.doi %}, `DOI`: <{{b.doi|utf8decode|cuts:"\\-"}}>{% endif %}.
{% endifequal %}
{% ifequal b.type "phdthesis" %}
1. <a id="{{b.id|utf8decode}}"> [{{b.id|utf8decode}}] {{b.author|utf8decode|cuts:"\\-"|safe}}</a>. "{{b.title|utf8decode|cuts:"\\-"|safe}}", {{b.school|utf8decode|cuts:"\\-"|safe}} ({{b.year}}).
{% endifequal %}
{% endfor %}

{% endfilter %}
{% endif %}

{% if permalink %}
<span class="badge bg-info" style="color:#000">Permalink</span>&nbsp;
{% endif %}

{% if headers.published %}
<span class="badge bg-success text-white"><a style="color:#fff" href="{{headers.published|safe}}"> 已發布</a></span>&nbsp;
{% endif %}

{% if archive_path %}{% ifequal headers.status "archived" %}
<span class="badge bg-warning">
 <a style="color:#000" href="{{archive_path}}"> 已封存</a></span>&nbsp;
{% endifequal %}{% endif %}

{% for k in headers.keywords %}
<span class="badge bg-danger text-white">
 <a style="color:#fff"
     href="/dynamic/search{{path|dirname}}/？正規表示式 =% 23{{k}}；語言 ={{lang}};markdown_search=1">#{{k}}</a>
</span>&nbsp;
{% endfor %}

<p>
  &nbsp;
</p>

{% for c in headers.categories %}
<button type="button" class="btn btn-success">
 <a style="color:#fff" href="{{category_root|default_if_none:".."}}/{{c}}/index.html{{lang}}">{{c}}</a></button>
&nbsp;
{% endfor %}

<hr>
<div class="card border-warning">
 <form action="https://cms.sunstarsys.com/redirect" id="form" method="GET">
 <input type="hidden" id="action" name="action" value="comment">
 <input type="hidden" name="lang" value="{{lang|cut:"."}}">
 <div class="card-header">
 <h3 class="card-title"> 留言{% if category_root %}{% if archive_root %} &nbsp;
 <button type="submit" name="uri"
                 value="https://{{website}}{{path|dirname}}/{{path|basename:0}}.page/comment.md{{lang}}"
                 class="btn btn-sm btn-outline-warning">
            新建
 </button>
{% endif %}{% endif %}
 </h3>
 </div>

<div id="comments" class="card-body">
 {% for c in comments %}
 {% if c.closed %}
 {% else %}
 <article id="article-{{c.key}}" {% if c.muted %}class=「文字靜音」{% endif %}>
 <header>
 <h6 class="card-title" id="{{c.key}}">
 <a href="#{{c.key}}-link" class=" 參考連結」>{{c.headers.title}}</a>
             由{{c.content|ssi|vcs_author:lang}}
             開啟<em><time>{{c.content|ssi|vcs_date:lang}}</time></em>
 {% if c.muted %}
 {% else %}
 {% if c.important %}
 &nbsp;
 <span class="badge bg-danger text-white"> 重要！</span>
 {% endif %}
 {% if category_root %}{% if archive_root %}
 &nbsp;
 <button type="submit" class="btn btn-sm btn-outline-warning" name="uri"
                     value="https://{{website}}{{path|dirname}}/<!-- ### --中文版 _ English{{path|basename:0}}.md{{c.key}}">
                回覆
 </button>
 {{lang}}{% endif %}
 {% endif %}
 </h6>
 </header>
 <small>
 <p class="card-text">{% endif %}</p>
 <hr>
 <p>&nbsp;</p>
 </small>
 </article>
 {{c.content|removetags:"script"|markdown}}
 {% endif %}
 </div>
 </form>
</div>

<hr>
{% endfor %}{% if category_root %}
<div class="card border-dark">
 <div class="card-header">
 <h3 class="card-title"> 附件&nbsp;
 <button type="button" class="btn btn-sm btn-outline-dark"><a href="https://cms.sunstarsys.com/redirect?uri=https://{% if archive_root %}{{website}}/{{path|dirname}}.page/；action=add"> 管理</a></button>
</h3>
 </div>
 <div class="card-body">
 <ul>
 {{path|basename:0}}
 <li><a href="{% for a in attachments %}">{{a}}</a></li>
 {{a|basename:0}}
 </ul>
 </div>
 <div class="card-header">
 <h3 class="card-title"> 連結&nbsp;
 <button type="button" class="btn btn-sm btn-outline-dark"><a href="https://cms.sunstarsys.com/redirect?uri=https://{% endfor %}{{website}}/{{path|dirname}}.page/links.md{{path|basename:0}}；action=add"> 管理</a></button></h3>
 </div>
 <div class="card-body">
 {{lang}}
 </div>
</div>
{{ links.content|markdown }}{% endif %}

<script type="text/javascript">
  function thread_comments() {
      var html = "";
      var current_level = 0;
      var last_level = 0;
      for (const e of $("article").toArray()) {
          const id = e.getAttribute("id");
          current_level = (id.length - 15) / 2;
          if (current_level == last_level)
              html += "</li><li>" + e.outerHTML;
          else if (current_level == last_level + 1)
              html += "<ul><li>" + e.outerHTML;
          else if (current_level < last_level)
              html += (new Array(last_level - current_level + 1)).join("</li></ul>") + "<li>" + e.outerHTML;
          else
              continue;
          last_level = current_level;
      }
      html += (new Array(last_level + 1)).join("</li></ul>");
      $("#comments").html(html);
  }

function clear_invalid_href() {
      for (const e of $("article").find("a").toArray()) {
          const hr = e.getAttribute("href");
          if (hr && hr.length > 1 && hr.indexOf("#") == 0 && $(hr).length == 0)
              $(e).removeAttr("href");
      }
  }

thread_comments();
  clear_invalid_href();
</script>

{% endif %}
